/-- **`Π̂(n)/Π̂(n+3)` is the emitted affine-run quotient.** -/
theorem hatPi_ratio (n : ℕ) :
    Zeta2Hat.hatPi n / Zeta2Hat.hatPi (n + 3)
      = hornerQ Rn (n : ℚ) / hornerQ Rd (n : ℚ) :=
  hatPi_ratio_of n 3 _ _ (Rd_ne n) (Rd_eq _) (Rn_eq _)

/-- **`Π(n)/Π(n+3)` is the emitted affine-run quotient.** -/
