-- arm exists for.
set_option maxHeartbeats 1000000 in
/-- `K₁·zh·Rn·Sd·lden = K₂·zc·Sn·Rd·lnum` as a KERNEL verdict on integer lists, degree
311.  The two sides are left as `_` placeholders and the elaborator budget is raised: at
j = 2 (degree 278) writing them out explicitly made the elaborator do an `isDefEq` on the
whole product and it died at the 200 000-heartbeat default — MEASURED, and it is an
ELABORATOR limit, not a kernel one, so it appears in no cost table and the `decide` it
aborted had not started.  This is the shape the row's four walls were measured at. -/
theorem kernel_raw (t : ℚ) :
    hornerQ (zscale K1 (zmul (zmul zh Rn) (zmul Sd Zeta2Pair7Lam.lden))) t
      = hornerQ (zscale K2 (zmul (zmul zc Sn) (zmul Rd Zeta2Pair7Lam.lnum))) t :=
  hornerQ_eq_of_ztrim_zsub _ _ t (by decide +kernel)

/-- The same verdict, read as an equation between the factors' values. -/
theorem kernel_step (t : ℚ) :
    (K1 : ℚ) * (hornerQ zh t * hornerQ Rn t * (hornerQ Sd t * hornerQ Zeta2Pair7Lam.lden t))
      = (K2 : ℚ) * (hornerQ zc t * hornerQ Sn t * (hornerQ Rd t * hornerQ Zeta2Pair7Lam.lnum t)) := by
  simpa only [hornerQ_zscale, hornerQ_zmul] using kernel_raw t

theorem K_split1 : dc * Zeta2Pair7Lam.dln = K1 * Kg := by decide +kernel

theorem K_split2 : dh * Zeta2Pair7Lam.dld = K2 * Kg := by decide +kernel

/-! ## The row -/

/-- `α̃ʰ_3` in the base module's OWN representation — an integer list over one clearing
denominator, which is exactly how `StarForallCandt2Base` carries `al_j : List ℚ`.  Writing
the operator entry this way is what puts `Zeta2Pair7Pi.qeval_map_hornerQ` (the ∀-n twin of
PAIR-K2's `qeval_map_zdivq`) on the proof path rather than beside it: `polB_eval` turns
PAIR-6's `(polB al_j).eval n` into `qeval n al_j`, which is the left-hand side here. -/
def alHat : List ℚ := zh.map (fun c : ℤ => (c : ℚ) / (dh : ℚ))

/-- `α̃ᶜ_3`, the same way. -/
def alChain : List ℚ := zc.map (fun c : ℤ => (c : ℚ) / (dc : ℚ))

/-- `β̂_3(n) = α̃ʰ_3(n)·Π̂(n)/Π̂(n+3)` — the HAT solve's operator entry on the sequences.
The `Π̂` exponent is **−1** (`Zeta2HatRep`: `evalRep (repHat n) t = hatPi n * hatMember n t`),
and the `(−1)^j` of the certified `cleared_j` operator belongs there, NOT here. -/
def betaHat (n : ℕ) : ℚ :=
  qeval (n : ℚ) alHat * (Zeta2Hat.hatPi n / Zeta2Hat.hatPi (n + 3))

/-- `γ_3(n) = α̃ᶜ_3(n)·Π(n)/Π(n+3)` — the CHAIN solve's. -/
def gammaCh (n : ℕ) : ℚ :=
  qeval (n : ℚ) alChain * (candidateM.Pin n / candidateM.Pin (n + 3))

def lamNum (n : ℕ) : ℚ :=
  hornerQ Zeta2Pair7Lam.lnum (n : ℚ) / (Zeta2Pair7Lam.dln : ℚ)

def lamDen (n : ℕ) : ℚ :=
  hornerQ Zeta2Pair7Lam.lden (n : ℚ) / (Zeta2Pair7Lam.dld : ℚ)

/-- **ROW PAIR-7 at j = 3, ∀ n : ℕ.**  The two solves' operator entries are
proportional, with the j-independent ratio λ = λnum/λden. -/
theorem pair7_j3 (n : ℕ) : betaHat n * lamDen n = gammaCh n * lamNum n := by
  unfold betaHat gammaCh lamNum lamDen alHat alChain
  rw [qeval_map_hornerQ, qeval_map_hornerQ, hatPi_ratio n, Pin_ratio n]
  exact pair7_assemble
    (hornerQ zh (n : ℚ)) (hornerQ zc (n : ℚ)) (hornerQ Rn (n : ℚ)) (hornerQ Rd (n : ℚ))
    (hornerQ Sn (n : ℚ)) (hornerQ Sd (n : ℚ))
    (hornerQ Zeta2Pair7Lam.lnum (n : ℚ)) (hornerQ Zeta2Pair7Lam.lden (n : ℚ))
    (dh : ℚ) (dc : ℚ) (Zeta2Pair7Lam.dln : ℚ) (Zeta2Pair7Lam.dld : ℚ)
    (K1 : ℚ) (K2 : ℚ) (Kg : ℚ)
    (Int.cast_ne_zero.mpr (by decide)) (Int.cast_ne_zero.mpr (by decide))
    (Int.cast_ne_zero.mpr (by decide)) (Int.cast_ne_zero.mpr (by decide))
    (Rd_ne n) (Sd_ne n)
    (by exact_mod_cast K_split1) (by exact_mod_cast K_split2)
    (kernel_step (n : ℚ))

end Zeta2Pair7J3

