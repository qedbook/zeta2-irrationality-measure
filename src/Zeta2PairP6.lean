/-- The division identity `R + denPoly 6 · Q = numPoly 6`: the three numerator blocks
and the denominator block unfold to 162 and 67 explicit factors `X + k`, and `ring`
closes it. -/
theorem div_identity : R + candidateM.denPoly 6 * Q = candidateM.numPoly 6 := by
  simp only [Q, R, Member.numPoly, Member.denPoly, candidateM, block, Nat.reduceMul,
    Nat.reduceSub, Nat.reduceAdd, Finset.prod_range_succ, Finset.prod_range_zero, map_natCast,
    map_ofNat, map_neg, map_one]
  push_cast
  ring

theorem R_degree_lt : R.degree < (candidateM.denPoly 6).degree := by
  apply Polynomial.degree_lt_degree
  rw [candidateM.denPoly_natDegree 6]
  have h : R.natDegree ≤ 66 := by rw [R]; compute_degree!
  simp only [candidateM] at h ⊢
  omega

/-- **`Ppol 6` is `Q`** — the first evaluation of `candidateM.Ppol` in the corpus. -/
theorem Ppol_eq : candidateM.Ppol 6 = Q :=
  (Polynomial.div_modByMonic_unique Q R (candidateM.denPoly_monic 6)
    ⟨div_identity, R_degree_lt⟩).1

theorem cell_eq : candidateM.cell 6 = -25 := by decide

/-- `Σ_j Q_j · momI (cell 6) j` — the polynomial half of `pn 6`, the number
`Zeta2DefsCheck.enginePnPoly` only RECORDS.  `sum_momI` replaces the noncomputable `momI`
under the sum by the 96-entry list `momList (-25) 96`, which the kernel
builds ONCE; `simp only [Q, …]` turns each `Q.coeff j` into its literal.  Row PAIR-VAL. -/
theorem pnPoly_eq : candidateM.pnPoly 6 = (-305500713176552617861874651378564371805913259259705374417461020746356090899827104070309545158842751048698307538570385168488556294016104187933373897572953466839770084477028207807828999560821313197809771788570777688945459200000000000000000000 / 3024658859 : ℚ) := by
  have hd : (candidateM.Ppol 6).natDegree = 95 := by
    rw [candidate_Ppol_natDegree]
  rw [Member.pnPoly, hd, Ppol_eq, cell_eq, Zeta2MomC.sum_momI]
  simp only [Q, coeff_add, coeff_C_mul_X_pow]
  decide +kernel

/-- The harmonic half, computable: `Σ_k ck 6 k · H^{(2)}_{k − 25}` over the window.
`Zeta2HarmC.pnHarm_shared` puts ONE `harmList 2 132` under the sum and indexes it, so the
kernel adds 132 rationals instead of recomputing `harm 2` at each of the 67 window
terms (row PAIR-VAL, third pass — the same lever `Zeta2MomC.sum_momI` is on the moment side). -/
theorem pnHarm_eq : candidateM.pnHarm 6 = (5561731205247487733982847297549942396233873976897872942931592925815672409521867668282894172360266123763981396271142834180699349164718925961054343385161081780948196653977772737314111708325353958879013730724948717319306713497600000000000000000000 / 202652143553 : ℚ) := by
  rw [Zeta2HarmC.pnHarm_shared candidateM (by decide) 6]
  decide +kernel

/-- **`pn 6`, evaluated** — the same literal `hatP_engine` below pins from the hat side. -/
theorem pn_eq : candidateM.pn 6 = (-179036734990249857192651768518124336348704152677881550535247797226505022760796114856373256605799446231825104743802148627459159050370094539843 / 8279469852949928839579664934731760 : ℚ) := by
  rw [Member.pn, pnPoly_eq, pnHarm_eq]
  decide +kernel

/-- Kernel pin on the HAT side: `hatP 6` is the tale-1 engine's `p_6`.  Rendered by
`gen_hat_lean.hatP_pin_lines`, the same function `Zeta2HatCheck.lean` uses for n ≤ 3. -/
theorem hatP_engine : hatP 6 = (-179036734990249857192651768518124336348704152677881550535247797226505022760796114856373256605799446231825104743802148627459159050370094539843 / 8279469852949928839579664934731760 : ℚ) := by
  rw [Zeta2HarmC.hatP_shared]
  simp only [hatA, Nat.choose_eq_descFactorial_div_factorial]
  decide +kernel

/-- **The row's statement at n = 6**: `hatP 6 = candidateM.pn 6`. -/
theorem hatP_eq_pn : hatP 6 = candidateM.pn 6 := by
  rw [hatP_engine, pn_eq]

