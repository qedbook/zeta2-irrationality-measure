    fun t => nd_le (afProd_natDegree_le cFacs t) (by simp (maxSteps := 20000000) [cFacs])
  have hp0 : (afProd pa0Facs t).natDegree ≤ 96 :=
    nd_le (afProd_natDegree_le pa0Facs t) (by simp (maxSteps := 20000000) [pa0Facs])
  have hal0 : (polB al0).natDegree ≤ 180 :=
    polB_natDegree_le al0 180 (by simp (maxSteps := 20000000) [al0])
  have hp1 : (afProd pa1Facs t).natDegree ≤ 112 :=
    nd_le (afProd_natDegree_le pa1Facs t) (by simp (maxSteps := 20000000) [pa1Facs])
  have hal1 : (polB al1).natDegree ≤ 164 :=
    polB_natDegree_le al1 164 (by simp (maxSteps := 20000000) [al1])
  have hp2 : (afProd pa2Facs t).natDegree ≤ 128 :=
    nd_le (afProd_natDegree_le pa2Facs t) (by simp (maxSteps := 20000000) [pa2Facs])
  have hal2 : (polB al2).natDegree ≤ 148 :=
    polB_natDegree_le al2 148 (by simp (maxSteps := 20000000) [al2])
  have hp3 : (afProd pa3Facs t).natDegree ≤ 144 :=
    nd_le (afProd_natDegree_le pa3Facs t) (by simp (maxSteps := 20000000) [pa3Facs])
  have hal3 : (polB al3).natDegree ≤ 132 :=
    polB_natDegree_le al3 132 (by simp (maxSteps := 20000000) [al3])
  have hm0 : (polB al0 * afProd pa0Facs t).natDegree ≤ 276 :=
    nd_le (nd_mul hal0 hp0) (by norm_num)
  have hm1 : (polB al1 * afProd pa1Facs t).natDegree ≤ 276 :=
    nd_le (nd_mul hal1 hp1) (by norm_num)
  have hm2 : (polB al2 * afProd pa2Facs t).natDegree ≤ 276 :=
    nd_le (nd_mul hal2 hp2) (by norm_num)
  have hm3 : (polB al3 * afProd pa3Facs t).natDegree ≤ 276 :=
    nd_le (nd_mul hal3 hp3) (by norm_num)
  have hsum : (polB al0 * afProd pa0Facs t
        + polB al1 * afProd pa1Facs t
        + polB al2 * afProd pa2Facs t
        + polB al3 * afProd pa3Facs t).natDegree ≤ 276 :=
    nd_add (nd_add (nd_add hm0 hm1) hm2) hm3
  show (afProd aFacs t * polB2 xCoeffs (t + 1)
    - afProd bFacs (t - 1) * polB2 xCoeffs t
    - afProd cFacs t * (polB al0 * afProd pa0Facs t
        + polB al1 * afProd pa1Facs t
        + polB al2 * afProd pa2Facs t
        + polB al3 * afProd pa3Facs t)).natDegree ≤ 276
  exact nd_sub (nd_sub (nd_le (nd_mul (ha t) (hx (t + 1))) (by norm_num))
      (nd_le (nd_mul (hb (t - 1)) (hx t)) (by norm_num)))
    (nd_le (nd_mul (hc t) hsum) (by norm_num))

/-! ## The grid -/

/-- The first 277 natural numbers, as a `Finset ℚ`. -/
noncomputable def grid : Finset ℚ :=
  (Finset.range 277).image (fun k : ℕ => (k : ℚ))

theorem hcard : grid.card = 277 := by
  rw [grid, Finset.card_image_of_injective _ (Nat.cast_injective (R := ℚ)), Finset.card_range]

theorem hs : 276 < grid.card := by rw [hcard]; omega

/-- The `∀ n` step, with the per-point vanishing as its ONE remaining
hypothesis.  Each `h0` point is proved in its OWN module against this one. -/
theorem star_forall_of_h0 (t : ℚ) (h0 : ∀ v ∈ grid, (F t).eval v = 0) :
    ∀ v : ℚ, (F t).eval v = 0 :=
  star_forall_of_grid (F t) 276 (hdeg t) grid hs h0

end StarForallCandt1

