    unfold cb
    rw [hR13, hR9, hR5, hR26, hR24, hR22, wrap_mod hu hR26b, wrap_mod hu hR24b, wrap_mod hu hR22b]
    split_ifs <;> omega
  unfold kumLoR
  omega

/-- stratum 52: `[8/17, 1/2)`, φ̃ = 0, the terms above `26n`. -/
theorem polh_S52 {p r u : ℕ} (hp : 0 < p) (hr : r < p) (hu : u < p)
    (hlo : 8 * p ≤ 17 * r) (hhi : 2 * r < 1 * p) :
    0 + 1 ≤ kumHiR p r 0 u + 1 := by
  obtain ⟨R11, hR11, hR11a, hR11b⟩ := residue_spec (q := 5) (a := 11 * r) hp (by omega) (by omega)
