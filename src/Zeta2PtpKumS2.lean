  obtain ⟨R13, hR13, hR13a, hR13b⟩ := residue_spec (q := 6) (a := 13 * r) hp (by omega) (by omega)
  obtain ⟨R9, hR9, hR9a, hR9b⟩ := residue_spec (q := 4) (a := 9 * r) hp (by omega) (by omega)
  obtain ⟨R5, hR5, hR5a, hR5b⟩ := residue_spec (q := 2) (a := 5 * r) hp (by omega) (by omega)
  obtain ⟨R26, hR26, hR26a, hR26b⟩ := residue_spec (q := 12) (a := 26 * r) hp (by omega) (by omega)
  obtain ⟨R24, hR24, hR24a, hR24b⟩ := residue_spec (q := 11) (a := 24 * r) hp (by omega) (by omega)
  obtain ⟨R22, hR22, hR22a, hR22b⟩ := residue_spec (q := 10) (a := 22 * r) hp (by omega) (by omega)
  have hK : 0 ≤ cb p ((26 * r) % p + p - u) (13 * r) + cb p ((24 * r) % p + p - u) (9 * r)
