/-! ## §4. `π` cancels out of the phase

This identity is why C7 needs no `Real.pi` enclosure and no arctan enclosure for `g`
itself: the `κπw` of the phase is exactly the `κπ` of `g'` times `w`. -/

/-- `g(w) = c + ½(Σ qᵢ log(qᵢ²+w²) - D log(D²+w²)) + w·g'(w)`, for every parameter set. -/
theorem phase_eq_logpart {ι : Type*} (s : Finset ι) (qf : ι → ℝ) (D κ c w : ℝ) :
    Zeta2SupScheme.phase s qf D κ c w
      = c + (1 / 2) * ((∑ i ∈ s, qf i * Real.log (qf i ^ 2 + w ^ 2))
          - D * Real.log (D ^ 2 + w ^ 2))
        + w * Zeta2SupScheme.phaseD s qf D κ w := by
  have h1 : (∑ i ∈ s, Zeta2SupScheme.Lterm (qf i) w)
      = (1 / 2) * (∑ i ∈ s, qf i * Real.log (qf i ^ 2 + w ^ 2))
        - w * ∑ i ∈ s, Real.arctan (w / qf i) := by
    rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_sub_distrib]
    exact Finset.sum_congr rfl fun i _ => by rw [Zeta2SupScheme.Lterm]; ring
  rw [Zeta2SupScheme.phase, Zeta2SupScheme.phaseD, h1, Zeta2SupScheme.Lterm]
  ring

/-- Route B's log sum with the vector notation resolved once, for an arbitrary `w`. -/
theorem logsum_expand (w : ℝ) :
    (∑ i ∈ (Finset.univ : Finset (Fin 7)), Zeta2SupScheme.qB i
        * Real.log (Zeta2SupScheme.qB i ^ 2 + w ^ 2))
      = (13 - Zeta2SupScheme.sigT) * Real.log ((13 - Zeta2SupScheme.sigT) ^ 2 + w ^ 2)
        + (11 - Zeta2SupScheme.sigT) * Real.log ((11 - Zeta2SupScheme.sigT) ^ 2 + w ^ 2)
        + (9 - Zeta2SupScheme.sigT) * Real.log ((9 - Zeta2SupScheme.sigT) ^ 2 + w ^ 2)
        + (15 - Zeta2SupScheme.sigT) * Real.log ((15 - Zeta2SupScheme.sigT) ^ 2 + w ^ 2)
        + Zeta2SupScheme.sigT * Real.log (Zeta2SupScheme.sigT ^ 2 + w ^ 2)
        + (Zeta2SupScheme.sigT - 2) * Real.log ((Zeta2SupScheme.sigT - 2) ^ 2 + w ^ 2)
        + (Zeta2SupScheme.sigT - 4) * Real.log ((Zeta2SupScheme.sigT - 4) ^ 2 + w ^ 2) := by
  simp [Zeta2SupScheme.qB, Fin.sum_univ_seven]

