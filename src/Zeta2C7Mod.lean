/-! ## §1. Primitives

`arctan_le_self` is the only arctan bound C7 needs, and it is two lines from
`Real.le_tan`.  `logNear_of_series` is Mathlib's remainder bound with the series value
and the error both supplied as literals, which is what makes it `norm_num`-able. -/

/-- `arctan t ≤ t` for `t ≥ 0` — Mathlib has `Real.le_tan`, read at `t = arctan x`. -/
theorem arctan_le_self {x : ℝ} (hx : 0 ≤ x) : Real.arctan x ≤ x := by
  have h := Real.le_tan (Real.arctan_nonneg.mpr hx) (Real.arctan_lt_pi_div_two x)
  rwa [Real.tan_arctan] at h

/-- Mathlib's `log (1-x)` Taylor remainder, with the partial sum and the error as
literals so that both side conditions fall to `norm_num`. -/
theorem logNear_of_series {x : ℝ} (hx : |x| < 1) (n : ℕ) {S E : ℝ}
    (hS : ∑ i ∈ Finset.range n, x ^ (i + 1) / (i + 1) = S)
    (hE : |x| ^ (n + 1) / (1 - |x|) ≤ E) : |S + Real.log (1 - x)| ≤ E := by
  have h := Real.abs_log_sub_add_sum_range_le hx n
  rw [hS] at h
  exact h.trans hE

