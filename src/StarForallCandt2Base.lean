/-! ## `F` and its degree bound -/

/-- The CLEARED (★) residual, as a polynomial in `n` with `t` a parameter.
UNEXPANDED: every product stays a product. -/
noncomputable def F (t : ℚ) : ℚ[X] :=
  afProd aFacs t * polB2 xCoeffs (t + 1)
    - afProd bFacs (t - 1) * polB2 xCoeffs t
    - afProd cFacs t * (polB al0 * afProd pa0Facs t
        + polB al1 * afProd pa1Facs t
        + polB al2 * afProd pa2Facs t
        + polB al3 * afProd pa3Facs t)

/-- `F`'s unfolding, stated as a theorem so that a module which IMPORTS this
one can rewrite with it.  `simp only [F]` across an import exhausts the
recursion budget; `rfl` does not. -/
theorem F_def (t : ℚ) : F t =
    afProd aFacs t * polB2 xCoeffs (t + 1)
      - afProd bFacs (t - 1) * polB2 xCoeffs t
