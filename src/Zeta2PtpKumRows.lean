theorem coeffBoundOpen_of_residual (h : ResidualRowsOpen) : CoeffBoundOpen :=
  coeffBoundOpen_of_rows kummerRowsOpen h

theorem polyHalfOpen_of_residual (h : ResidualRowsOpen) : PolyHalfOpen :=
  polyHalfOpen_of_rows kummerRowsOpen h

/-! ## The polar rows OFF the five run strata, by the same count — the residual NARROWED -/

/-- The sibling's five run strata, as residue inequalities: `[1/9, 2/17)`, `[3/13, 4/17)`,
`[6/13, 7/15)`, `[5/9, 9/16)`, `[12/13, 14/15)`. -/
def RunStrata (p r : ℕ) : Prop :=
  (p ≤ 9 * r ∧ 17 * r < 2 * p) ∨ (3 * p ≤ 13 * r ∧ 17 * r < 4 * p)
    ∨ (6 * p ≤ 13 * r ∧ 15 * r < 7 * p) ∨ (5 * p ≤ 9 * r ∧ 16 * r < 9 * p)
    ∨ (12 * p ≤ 13 * r ∧ 15 * r < 14 * p)

theorem polar_cover_S105 {n p u : ℕ} (hp : 0 < p) (hu : u < p)
    (hlo : 25 * p ≤ 26 * (n % p)) :
    RunStrata p (n % p)
      ∨ (phiT (Int.fract ((n : ℚ) / (p : ℚ))) + 1 ≤ kumLoR p (n % p) 0 u + 1
        ∧ phiT (Int.fract ((n : ℚ) / (p : ℚ))) + 1 ≤ kumHiR p (n % p) 0 u + 1) := by
  have hhi : 1 * (n % p) < 1 * p := by
    have := Nat.mod_lt n hp
    omega
  refine Or.inr ⟨?_, ?_⟩
  · rw [wire_S105 hp hlo hhi]
    exact pol_S105 hp (Nat.mod_lt n hp) hu hlo hhi
  · rw [wire_S105 hp hlo hhi]
    exact polh_S105 hp (Nat.mod_lt n hp) hu hlo hhi

