    exact pol_S2 hp (Nat.mod_lt n hp) hu hlo hhi
  · rw [wire_S2 hp hlo hhi]
    exact polh_S2 hp (Nat.mod_lt n hp) hu hlo hhi

theorem polar_cover_S1 {n p u : ℕ} (hp : 0 < p) (hu : u < p)
    (hlo : 1 * p ≤ 26 * (n % p)) :
    RunStrata p (n % p)
      ∨ (phiT (Int.fract ((n : ℚ) / (p : ℚ))) + 1 ≤ kumLoR p (n % p) 0 u + 1
        ∧ phiT (Int.fract ((n : ℚ) / (p : ℚ))) + 1 ≤ kumHiR p (n % p) 0 u + 1) := by
  rcases Nat.lt_or_ge (24 * (n % p)) (1 * p) with hhi | hhi
  swap
  · exact polar_cover_S2 hp hu hhi
  refine Or.inr ⟨?_, ?_⟩
  · rw [wire_S1 hp hlo hhi]
    exact pol_S1 hp (Nat.mod_lt n hp) hu hlo hhi
  · rw [wire_S1 hp hlo hhi]
    exact polh_S1 hp (Nat.mod_lt n hp) hu hlo hhi

theorem polar_cover_S0 {n p u : ℕ} (hp : 0 < p) (hu : u < p)
    (hlo : 0 * p ≤ 1 * (n % p)) :
    RunStrata p (n % p)
      ∨ (phiT (Int.fract ((n : ℚ) / (p : ℚ))) + 1 ≤ kumLoR p (n % p) 0 u + 1
        ∧ phiT (Int.fract ((n : ℚ) / (p : ℚ))) + 1 ≤ kumHiR p (n % p) 0 u + 1) := by
  rcases Nat.lt_or_ge (26 * (n % p)) (1 * p) with hhi | hhi
  swap
  · exact polar_cover_S1 hp hu hhi
  refine Or.inr ⟨?_, ?_⟩
  · rw [wire_S0 hp hlo hhi]
    exact pol_S0 hp (Nat.mod_lt n hp) hu hlo hhi
  · rw [wire_S0 hp hlo hhi]
    exact polh_S0 hp (Nat.mod_lt n hp) hu hlo hhi


/-- **The polar residue statement**: off the run strata every term of `h_m` carries `φ̃ + 1`
units bits at a polar row. -/
theorem polar_main {n p u : ℕ} (hp : 0 < p) (hu : u < p) :
    RunStrata p (n % p)
      ∨ (phiT (Int.fract ((n : ℚ) / (p : ℚ))) + 1 ≤ kumLoR p (n % p) 0 u + 1
        ∧ phiT (Int.fract ((n : ℚ) / (p : ℚ))) + 1 ≤ kumHiR p (n % p) 0 u + 1) :=
  polar_cover_S0 hp hu (by omega)

/-- **THE RESIDUAL, NARROWED TO THE 51**: the polar rows ON the five run strata, and the rows
with `p² ≤ m`. -/
def ResidualNarrowOpen : Prop :=
  ∀ n p r : ℕ, p ∈ phiWindow n → r < 16 * n →
    ((p ∣ r + 1 ∧ RunStrata p (n % p)) ∨ p ^ 2 ≤ 11 * n + 1 + r) →
    PVal p (phiT (Int.fract ((n : ℚ) / (p : ℚ))) + bbit n p r - 1) ((coeff n r : ℤ) : ℚ)

/-- **`ResidualRowsOpen` FROM THE NARROWED RESIDUAL**: a polar row off the run strata with
`m < p²` is the units count again. -/
theorem residualRowsOpen_of_narrow (h : ResidualNarrowOpen) : ResidualRowsOpen := by
  intro n p r hp hr hres
  have hp0 := (prime_of_mem_phiWindow hp).pos
  have hp1 := (prime_of_mem_phiWindow hp).one_lt
  by_cases hsq : p ^ 2 ≤ 11 * n + 1 + r
  · exact h n p r hp hr (Or.inr hsq)
  have hpol : p ∣ r + 1 := by
    rcases hres with h1 | h1
    · exact h1
    · exact absurd h1 hsq
  by_cases hrun : RunStrata p (n % p)
  · exact h n p r hp hr (Or.inl ⟨hpol, hrun⟩)
  have hρ0 : (r + 1) % p = 0 := Nat.mod_eq_zero_of_dvd hpol
  rw [bbit_polar hpol]
  refine pval_coeff_of_kum hp (fun i _ hi => ?_) (fun i _ hi => ?_)
  · rw [padicValNat_LC_polar hp (by omega) hpol, kumLo_eq_res hp0 hi, hρ0]
    rcases polar_main (n := n) hp0 (Nat.mod_lt i hp0) with h1 | ⟨h1, _⟩
    · exact absurd h1 hrun
    · omega
  · rw [padicValNat_LC_polar hp (by omega) hpol, kumHi_eq_res hp1 hi, hρ0]
    rcases polar_main (n := n) hp0 (Nat.mod_lt i hp0) with h1 | ⟨_, h1⟩
    · exact absurd h1 hrun
    · omega

theorem coeffBoundOpen_of_narrow (h : ResidualNarrowOpen) : CoeffBoundOpen :=
  coeffBoundOpen_of_rows kummerRowsOpen (residualRowsOpen_of_narrow h)

theorem polyHalfOpen_of_narrow (h : ResidualNarrowOpen) : PolyHalfOpen :=
  polyHalfOpen_of_rows kummerRowsOpen (residualRowsOpen_of_narrow h)

