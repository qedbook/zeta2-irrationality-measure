/-- `φ̃ = 0` on an interval that meets no piece. -/
theorem phiT_gap {x lo hi : ℚ} (h1 : lo ≤ x) (h2 : x < hi)
    (hgap : ∀ t ∈ Zeta2Profile.candidateProfile, t.2.1 ≤ lo ∨ hi ≤ t.1) : phiT x = 0 := by
  apply phiT_of_find_none
  rw [List.find?_eq_none]
  intro t ht
  rcases hgap t ht with h | h
  · simp only [decide_eq_true_eq, not_and, not_lt]
    intro h3
    linarith
  · simp only [decide_eq_true_eq, not_and, not_lt]
    intro h3
    linarith

theorem wire_S0 {n p : ℕ} (hp : 0 < p) (hlo : 0 * p ≤ 1 * (n % p))
    (hhi : 26 * (n % p) < 1 * p) : phiT (Int.fract ((n : ℚ) / (p : ℚ))) = 0 := by
  have h1 : ((0 : ℚ) / 1) ≤ Int.fract ((n : ℚ) / (p : ℚ)) := by
    have h := (fract_ge_iff n p 0 1 hp (by norm_num)).2 (by omega)
    exact_mod_cast h
  have h2 : Int.fract ((n : ℚ) / (p : ℚ)) < ((1 : ℚ) / 26) := by
    have h := (fract_lt_iff n p 1 26 hp (by norm_num)).2 (by omega)
    exact_mod_cast h
  exact phiT_gap h1 h2 (by decide +kernel)

