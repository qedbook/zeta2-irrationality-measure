/-- **The residue statement at every `(n, p, ρ, u)`.** -/
theorem residue_main {n p ρ u : ℕ} (hp : 0 < p) (hρ1 : 1 ≤ ρ) (hρ : ρ < p) (hu : u < p) :
    targetR p (n % p) ρ (phiT (Int.fract ((n : ℚ) / (p : ℚ)))) ≤ kumLoR p (n % p) ρ u + 1
      ∧ targetR p (n % p) ρ (phiT (Int.fract ((n : ℚ) / (p : ℚ)))) ≤ kumHiR p (n % p) ρ u + 1 :=
  cover_S0 hp hρ1 hρ hu (by omega)

/-- **`KummerRowsOpen` IS A THEOREM.** -/
theorem kummerRowsOpen : KummerRowsOpen := by
  intro n p r hp hr hpol hm _
  have hp0 := (prime_of_mem_phiWindow hp).pos
  have hp1 := (prime_of_mem_phiWindow hp).one_lt
  have hρ1 : 1 ≤ (r + 1) % p := by
    rcases Nat.eq_zero_or_pos ((r + 1) % p) with h | h
    · exact absurd (Nat.dvd_of_mod_eq_zero h) hpol
    · exact h
  have hρ := Nat.mod_lt (r + 1) hp0
  refine ⟨fun i _ hi => ?_, fun i _ hi => ?_⟩
  · rw [target_eq_res hp hm hρ1, kumLo_eq_res hp0 hi]
    exact (residue_main hp0 hρ1 hρ (Nat.mod_lt i hp0)).1
  · rw [target_eq_res hp hm hρ1, kumHi_eq_res hp1 hi]
    exact (residue_main hp0 hρ1 hρ (Nat.mod_lt i hp0)).2

