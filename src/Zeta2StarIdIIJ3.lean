  (StarForallCandt1.polB StarForallCandt1.al3).eval (n : ℚ)

/-- **The common cofactor `W`** — `w13 = 13·W`, and it is `Zeta2StarIdII`'s own `W`. -/
def Wq (n : ℕ) : ℚ := ((hornerZ w13 (n : ℤ) : ℤ) : ℚ) / 13

/-- `cⱼ` and the Pochhammers at a natural argument, as rationals. -/
def Cq (L : List ℤ) (n : ℕ) : ℚ := ((hornerZ L (n : ℤ) : ℤ) : ℚ)

/--
**STAR-ID (ii) at `j = 3`.**  `c3 · N3 = −(Ã3 · D3 · W)` at every natural `n`, with the
SAME `W` as `Zeta2StarIdII.star_ii_j0` and `.star_ii_j3` — which is the `j`-independence
`Zeta2StarB1.star_growth_bound_eventual`'s `hⱼ : Pⱼ.eval n = B.eval n * αⱼ n` needs.
-/
theorem star_ii_j3 (n : ℕ) :
    Cq c3 n * Cq n3 n = -(Atil3 n * Cq d3 n * Wq n) := by
  have hz := ii_int (n : ℤ)
  have hq : ((hornerZ az3 (n : ℤ) : ℤ) : ℚ) * ((hornerZ d3 (n : ℤ) : ℤ) : ℚ)
        * ((hornerZ w13 (n : ℤ) : ℤ) : ℚ)
      = ((s3 : ℤ) : ℚ)
        * (((hornerZ c3 (n : ℤ) : ℤ) : ℚ) * ((hornerZ n3 (n : ℤ) : ℤ) : ℚ)) := by
    exact_mod_cast congrArg (fun z : ℤ => (z : ℚ)) hz
  have hs : ((s3 : ℤ) : ℚ) = -(((ad3 : ℤ) : ℚ) * 13) := by
    show ((-((ad3 : ℤ) * 13) : ℤ) : ℚ) = -(((ad3 : ℤ) : ℚ) * 13)
    push_cast
    ring
  rw [hs] at hq
  rw [Cq, Cq, Cq, Atil3, al3_clear,
    polB_map_div_eval az3 (((ad3 : ℤ) : ℚ)) n, Wq]
  have had := ad3_ne
  have h13 : (13 : ℚ) ≠ 0 := by norm_num
  field_simp
  -- The coefficient is `1` and it is NOT cosmetic: at odd `j` the target carries a leading
  -- minus, so `field_simp` leaves the goal in the SAME orientation as `hq`, and at even `j` in
  -- the OPPOSITE one.  A single spelling closes one parity and fails the other with `ring
  -- failed`.  The `--tiny` fixture is the oracle — it runs this exact script at toy sizes in
  -- seconds, and it is where the even-`j` orientation was found, before any real run.
  linear_combination 1 * hq

