/-- **The real-part rearrangement.** -/
theorem per_step_re (z : ℂ) (N : ℕ)
    (habel : ∑ k ∈ Finset.range (N + 1),
        ((z + (k : ℂ) + 1/2) * Complex.log (1 + 1/(z + (k : ℂ))) - 1)
      = (z + ((N : ℂ) + 1) - 1/2) * Complex.log (z + ((N : ℂ) + 1))
        - (z + 1/2) * Complex.log z
        - (∑ m ∈ Finset.Ico 1 (N + 1), Complex.log (z + (m : ℂ))) - ((N : ℂ) + 1)) :
    (∑ k ∈ Finset.range (N + 1),
        ((z + (k : ℂ) + 1/2) * Complex.log (1 + 1/(z + (k : ℂ))) - 1)).re
      = ((z + ((N : ℂ) + 1) + 1/2) * Complex.log (z + ((N : ℂ) + 1))).re
        - ((z - 1/2) * Complex.log z).re
        - (∑ j ∈ Finset.range (N + 2), Real.log ‖z + (j : ℂ)‖)
        - ((N : ℝ) + 1) := by
  -- the full sum over j = 0..N+1, split off both ends
  have hsplit : (∑ j ∈ Finset.range (N + 2), Complex.log (z + (j : ℂ)))
      = Complex.log z + (∑ m ∈ Finset.Ico 1 (N + 1), Complex.log (z + (m : ℂ)))
        + Complex.log (z + ((N : ℂ) + 1)) := by
    rw [Finset.sum_range_succ]
    congr 1
    · rw [Finset.range_eq_Ico, Finset.sum_eq_sum_Ico_succ_bot (by omega)]
      simp
    · push_cast
      ring
  -- Re of the j-sum is the sum of log-moduli
  have hre : (∑ j ∈ Finset.range (N + 2), Complex.log (z + (j : ℂ))).re
      = ∑ j ∈ Finset.range (N + 2), Real.log ‖z + (j : ℂ)‖ := by
    rw [Complex.re_sum]
    exact Finset.sum_congr rfl fun j _ => Complex.log_re _
  rw [habel]
  have hIco : (∑ m ∈ Finset.Ico 1 (N + 1), Complex.log (z + (m : ℂ)))
      = (∑ j ∈ Finset.range (N + 2), Complex.log (z + (j : ℂ)))
        - Complex.log z - Complex.log (z + ((N : ℂ) + 1)) := by
    rw [hsplit]; ring
  rw [hIco]
  simp only [Complex.sub_re, Complex.add_re, Complex.one_re, Complex.natCast_re, hre]
  have hmul : ((z + ((N : ℂ) + 1) - 1/2) * Complex.log (z + ((N : ℂ) + 1))).re
      + (Complex.log (z + ((N : ℂ) + 1))).re
      = ((z + ((N : ℂ) + 1) + 1/2) * Complex.log (z + ((N : ℂ) + 1))).re := by
    rw [← Complex.add_re]
    congr 1
    ring
  have hmul2 : ((z + 1/2) * Complex.log z).re - (Complex.log z).re
      = ((z - 1/2) * Complex.log z).re := by
    rw [← Complex.sub_re]
    congr 1
    ring
  linarith [hmul, hmul2]

end Zeta2BinetTie6
