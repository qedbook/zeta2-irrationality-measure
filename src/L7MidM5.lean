    (∀ w : ℝ, 3 ≤ w → phase Finset.univ qA 22 (1/2) c w ≤ (G + ε * r) - c₀ * (w - 3)) :=
  ⟨phase_sup_le _ _ _ 11 _ _ (by norm_num) qA_pos qA_le routeA_h1 routeA_h2 hr hbl hbr hε hG,
