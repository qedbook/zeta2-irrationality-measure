/-! ## §1. `e^{−b|s|}` is integrable on ℝ

**MEASURED ABSENCE** (`LEAN.md` §2): current Mathlib has `exp_neg_integrableOn_Ioi`,
`integrableOn_exp_mul_Iic`, `integrableOn_exp_Iic` and the Gaussian `integrable_exp_neg_mul_sq`,
but nothing about `exp (-b * |x|)` on the whole line — searched by concept across
`Mathlib/MeasureTheory/` and `Mathlib/Analysis/SpecialFunctions/` on 2026-09-08
(`integrable_exp_neg_abs`, `exp_neg_abs`, `comp_abs`, `Laplace`).  Six lines from the two
half-line lemmas. -/
theorem integrable_exp_neg_mul_abs {b : ℝ} (hb : 0 < b) :
    Integrable (fun s : ℝ => Real.exp (-b * |s|)) volume := by
  have hIoi : IntegrableOn (fun s : ℝ => Real.exp (-b * |s|)) (Ioi (0 : ℝ)) volume :=
    (exp_neg_integrableOn_Ioi 0 hb).congr_fun
      (fun x hx => by rw [abs_of_pos hx]) measurableSet_Ioi
  have hIic : IntegrableOn (fun s : ℝ => Real.exp (-b * |s|)) (Iic (0 : ℝ)) volume :=
    (integrableOn_exp_mul_Iic hb 0).congr_fun
      (fun x hx => by rw [abs_of_nonpos hx]; ring_nf) measurableSet_Iic
  have hU : IntegrableOn (fun s : ℝ => Real.exp (-b * |s|)) (Iic (0 : ℝ) ∪ Ioi (0 : ℝ)) volume :=
    integrableOn_union.mpr ⟨hIic, hIoi⟩
  rw [Set.Iic_union_Ioi] at hU
  exact integrableOn_univ.mp hU

/-! ## §2. The global affine majorant

C6 delivers a SUP bound on `[0,∞)` and a TANGENT bound on `[3,∞)`.  Neither alone is an
integrability certificate; together they give one clean affine majorant on the whole half-line,
and that single inequality is what carries both the domination and the `|s|` change of
variable.  `3·c₀` is exactly the gap between the two regimes. -/
theorem phase_affine_majorant {g : ℝ → ℝ} {G c₀ : ℝ} (hc₀ : 0 < c₀)
    (hsup : ∀ w : ℝ, 0 ≤ w → g w ≤ G)
    (htail : ∀ w : ℝ, 3 ≤ w → g w ≤ G - c₀ * (w - 3)) :
    ∀ w : ℝ, 0 ≤ w → g w ≤ (G + 3 * c₀) - c₀ * w := by
  intro w hw
  by_cases h : (3 : ℝ) ≤ w
  · have := htail w h; linarith
  · have := hsup w hw; nlinarith [not_le.mp h]

/-! ## §3. The three generic steps -/

/-- **Step 3 — integrability, DERIVED.**  `s ↦ e^{t·g(|s|/t)}` is integrable on ℝ, from
continuity plus the two C6 facts.  Nothing is assumed: the tail supplies the dominating
`e^{−c₀|s|}` and §2 stitches the two regimes together. -/
theorem integrable_exp_phase_line {g : ℝ → ℝ} {G c₀ t : ℝ}
    (hg : Continuous g) (ht : 0 < t) (hc₀ : 0 < c₀)
    (hsup : ∀ w : ℝ, 0 ≤ w → g w ≤ G)
    (htail : ∀ w : ℝ, 3 ≤ w → g w ≤ G - c₀ * (w - 3)) :
    Integrable (fun s : ℝ => Real.exp (t * g (|s| / t))) volume := by
  have hcont : Continuous fun s : ℝ => Real.exp (t * g (|s| / t)) :=
    Real.continuous_exp.comp (continuous_const.mul (hg.comp (continuous_abs.div_const t)))
  refine Integrable.mono' ((integrable_exp_neg_mul_abs hc₀).const_mul
      (Real.exp (t * (G + 3 * c₀)))) hcont.aestronglyMeasurable ?_
  filter_upwards with s
  rw [Real.norm_eq_abs, abs_of_pos (Real.exp_pos _), ← Real.exp_add]
  refine Real.exp_le_exp.mpr ?_
  have haff := phase_affine_majorant hc₀ hsup htail (|s| / t) (by positivity)
  have h1 : t * g (|s| / t) ≤ t * ((G + 3 * c₀) - c₀ * (|s| / t)) :=
    mul_le_mul_of_nonneg_left haff ht.le
  have h2 : t * ((G + 3 * c₀) - c₀ * (|s| / t)) = t * (G + 3 * c₀) + -c₀ * |s| := by
    field_simp; ring
  linarith [h1, h2.le, h2.ge]

/-- **Steps 1 and 2 — the fold and the substitution, in one identity.**
`∫_ℝ e^{t·g(|s|/t)} ds = 2t ∫_{(0,∞)} e^{t·g(w)} dw`.

`integral_comp_abs` is UNCONDITIONAL (it discharges the non-integrable case by sending both
sides to `0`), so this identity costs no integrability hypothesis — the integrability of §3 is
needed for the *comparison*, not for the change of variable. -/
theorem integral_exp_phase_line_fold {g : ℝ → ℝ} {t : ℝ} (ht : 0 < t) :
    (∫ s : ℝ, Real.exp (t * g (|s| / t)))
      = 2 * t * ∫ w in Set.Ioi (0 : ℝ), Real.exp (t * g w) := by
  have h3 : ∀ x : ℝ, t * x / t = x := fun x => by field_simp
  have h1 : (∫ s : ℝ, Real.exp (t * g (|s| / t)))
      = 2 * ∫ x in Set.Ioi (0 : ℝ), Real.exp (t * g (x / t)) :=
    integral_comp_abs (f := fun x : ℝ => Real.exp (t * g (x / t)))
  have h2 := integral_comp_mul_left_Ioi (fun y : ℝ => Real.exp (t * g (y / t))) 0 ht
  simp only [h3, mul_zero, smul_eq_mul] at h2
  have h4 : (∫ x in Set.Ioi (0 : ℝ), Real.exp (t * g (x / t)))
      = t * ∫ w in Set.Ioi (0 : ℝ), Real.exp (t * g w) := by
    rw [h2]; field_simp
  rw [h1, h4]; ring

/-! ## §4. THE JUNK-VALUE PIN — why step 3 is not optional

`LEAN.md` has one measured junk value in this program (`Real.log 0 = 0`, which cost M4 the
acceptance clause's own statement) and X-L7 has two more in `Filter.limsup`.  This is the
FOURTH, on the other side of the same `hrep` inequality: **Lean's `∫` of a non-integrable
function is `0`.**

So `hrep`'s right-hand side is not automatically positive.  If the phase did not decay, the
integral would be the junk value `0` and `hrep` would read `|r n| ≤ 0` — a statement about
`r` that no bound on `H_n` can establish.  The C6 tail fact is therefore load-bearing for the
STATEMENT of `hrep`, not merely for its proof, and "derive integrability, do not assume it" is
not hygiene: assuming it would have left the conclusion vacuous or false rather than unproved.

Exhibited rather than argued: at the constant (non-decaying) phase `g ≡ 0`, the right-hand
side's integral is `0` for every `n`. -/
theorem hrep_rhs_is_junk_without_decay (n : ℕ) :
    (∫ _w in Set.Ioi (0 : ℝ), Real.exp ((n : ℝ) * (0 : ℝ))) = 0 := by
  rw [MeasureTheory.setIntegral_const]
  simp [Measure.real, Real.volume_Ioi]

/-! ## §5. The assembled shape M5 consumes

The `H_n`-free skeleton of `hrep`: a complex-valued integrand whose norm obeys M4's bound gives
the `(n/π)·e^C` prefactor, with `2 · (1/(2π)) · t = t/π` the whole of the arithmetic.  Stated
here abstractly so the consolidated file's version differs only by substituting the real
`Hn`.

**MEASURED, and it removes a hypothesis the plan expected to need:** `F` needs NO measurability
assumption.  `norm_integral_le_integral_norm` is unconditional, and `integral_mono_of_nonneg`
asks for integrability of the DOMINATING function only — so the comparison never has to know
that `s ↦ ‖F s‖` is measurable.  (The glue establishes it anyway, for a different and more
important reason: to show `∫ s, H_n(line s)` is not itself Lean's junk value.  See §4.) -/
theorem norm_line_integral_le {F : ℝ → ℂ} {g : ℝ → ℝ} {G c₀ t C : ℝ}
    (hg : Continuous g) (ht : 0 < t) (hc₀ : 0 < c₀)
    (hsup : ∀ w : ℝ, 0 ≤ w → g w ≤ G)
    (htail : ∀ w : ℝ, 3 ≤ w → g w ≤ G - c₀ * (w - 3))
    (hbd : ∀ s : ℝ, ‖F s‖ ≤ Real.exp C * Real.exp (t * g (|s| / t))) :
    ‖(1 / (2 * Real.pi) : ℂ) * ∫ s : ℝ, F s‖
      ≤ t * (Real.exp C / Real.pi) * ∫ w in Set.Ioi (0 : ℝ), Real.exp (t * g w) := by
  have hpi : (0 : ℝ) < Real.pi := Real.pi_pos
  have hdom : Integrable (fun s : ℝ => Real.exp C * Real.exp (t * g (|s| / t))) volume :=
    (integrable_exp_phase_line hg ht hc₀ hsup htail).const_mul _
  have hstep1 : ‖∫ s : ℝ, F s‖ ≤ ∫ s : ℝ, ‖F s‖ := norm_integral_le_integral_norm _
  have hstep2 : (∫ s : ℝ, ‖F s‖)
      ≤ ∫ s : ℝ, Real.exp C * Real.exp (t * g (|s| / t)) :=
    integral_mono_of_nonneg (Filter.Eventually.of_forall fun s => norm_nonneg _) hdom
      (Filter.Eventually.of_forall hbd)
  have hstep3 : (∫ s : ℝ, Real.exp C * Real.exp (t * g (|s| / t)))
      = Real.exp C * (2 * t * ∫ w in Set.Ioi (0 : ℝ), Real.exp (t * g w)) := by
    rw [MeasureTheory.integral_const_mul, integral_exp_phase_line_fold ht]
  have hnorm : ‖(1 / (2 * Real.pi) : ℂ)‖ = 1 / (2 * Real.pi) := by
    rw [show ((1 : ℂ) / (2 * Real.pi)) = ((1 / (2 * Real.pi) : ℝ) : ℂ) by push_cast; ring]
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos (by positivity)]
  rw [norm_mul, hnorm]
  have hchain : ‖∫ s : ℝ, F s‖
      ≤ Real.exp C * (2 * t * ∫ w in Set.Ioi (0 : ℝ), Real.exp (t * g w)) := by
    rw [← hstep3]; linarith [hstep1, hstep2]
  have hfin := mul_le_mul_of_nonneg_left hchain (by positivity : (0 : ℝ) ≤ 1 / (2 * Real.pi))
  refine le_trans hfin (le_of_eq ?_)
  field_simp

