namespace Zeta2BinetComplete

open Complex Filter
open scoped Topology

/-- The assembly identity, hypothesis-free, for every `M ≥ 1`. -/
theorem assembly (z : ℂ) (hz : 0 < z.re) (M : ℕ) (hM : 0 < M) :
    (∑ k ∈ Finset.range M,
        ((z + (k : ℂ) + 1/2) * Complex.log (1 + 1/(z + (k : ℂ))) - 1)).re
      = ((z + (M : ℂ) + 1/2) * (Complex.log (z + (M : ℂ)) - Complex.log (M : ℂ))).re
        - (Real.log (Nat.factorial M) - (((M : ℝ) + 1/2) * Real.log M - (M : ℝ)))
        + (z.re * Real.log M + Real.log (Nat.factorial M)
            - ∑ j ∈ Finset.range (M + 1), Real.log ‖z + (j : ℂ)‖)
        - ((z - 1/2) * Complex.log z).re := by
  obtain ⟨N, rfl⟩ : ∃ N, M = N + 1 := ⟨M - 1, by omega⟩
  refine Zeta2BinetTie8.assembly_identity z (N + 1) (by omega) ?_
  have h := Zeta2BinetTie6.per_step_re z N (Zeta2BinetTie2.abel_sum z hz N)
  push_cast at h ⊢
  exact h

/-- **THE TIE, hypothesis-free.** For `Re z > 0`,

`Re μ(z) := lim_M Re ∑_{k<M} h(z+k) = Re z − ½·log 2π + log‖Γ z‖ − Re[(z−½)·Log z]`,

equivalently `log‖Γ(z)‖ = Re[(z−½)Log z − z] + ½·log 2π + Re μ(z)` — the Binet decomposition in
the log-modulus form L7 Lemma 4 consumes. -/
