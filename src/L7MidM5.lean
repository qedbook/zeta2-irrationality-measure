/-! ## §M1. Lemma 4 — the lower half, and the offset-3/2 denominator bound -/

/-- **L7 Lemma 4(1), TWO-SIDED.**  `zeta2-l7-proof.md` states only the upper half, and
`Zeta2L7Assembly.lemma4_upper` proves that; Theorem 5's eighth `Γ` sits in the DENOMINATOR and
needs the other side.  C1's `binet_bound` is two-sided already (`abs_le`), and the only other
one-sided step in `lemma4_upper` — the `Re ≤ ‖·‖` on the `log(1+ω)` remainder — is two-sided for
free, so the whole comparison is.  The constant `8/5` is the write-up's; the proof gives
`31/52 + 1/4 = 11/13`, so it clears by 16 %. -/
theorem lemma4_abs {n : ℕ} (hn : 1 ≤ n) {q w : ℝ} (hq : 0 < q) (hnq : 9 / 5 ≤ (n : ℝ) * q) :
    |Real.log ‖Complex.Gamma ((n : ℂ) * ((q : ℂ) + (w : ℂ) * Complex.I) + 1 / 2)‖
        - ((n : ℝ) * (q * Real.log n + Zeta2SupScheme.Lterm q w - q)
          + 1 / 2 * Real.log (2 * Real.pi))| ≤ 8 / 5 := by
  have binet := Zeta2BinetComplete.binet_bound
  set u : ℂ := (q : ℂ) + (w : ℂ) * Complex.I with hu
  have hure : u.re = q := by simp [hu]
  have hnpos : (0 : ℝ) < (n : ℝ) := by exact_mod_cast hn
  have hunorm : q ≤ ‖u‖ := by
    calc q = |u.re| := by rw [hure, abs_of_pos hq]
      _ ≤ ‖u‖ := Complex.abs_re_le_norm u
  have hnu : (9 : ℝ) / 5 ≤ (n : ℝ) * ‖u‖ := by nlinarith
  have hMpos : (0 : ℝ) < (n : ℝ) * ‖u‖ := by linarith
  have hune : u ≠ 0 := by
    intro h; rw [h] at hure; simp at hure; linarith
  have hnune : ((n : ℂ)) * u ≠ 0 := by
    refine mul_ne_zero ?_ hune
    exact_mod_cast Nat.cast_ne_zero.mpr (by omega : n ≠ 0)
  set om : ℂ := 1 / (2 * (n : ℂ) * u) with hom
  have hnormnu : ‖((n : ℂ)) * u‖ = (n : ℝ) * ‖u‖ := by
    rw [norm_mul]; congr 1; simp
  have hnormom : ‖om‖ = 1 / (2 * ((n : ℝ) * ‖u‖)) := by
    rw [hom, norm_div, norm_one]
    congr 1
    rw [show (2 : ℂ) * (n : ℂ) * u = 2 * ((n : ℂ) * u) by ring, norm_mul, hnormnu]
    simp
  have homle : ‖om‖ ≤ 5 / 18 := by
    rw [hnormom, div_le_div_iff₀ (by nlinarith) (by norm_num)]
    nlinarith
  have homlt : ‖om‖ < 1 := by linarith
  have h2nu : (2 : ℂ) * (n : ℂ) * u ≠ 0 := by
    rw [show (2 : ℂ) * (n : ℂ) * u = 2 * ((n : ℂ) * u) by ring]
    exact mul_ne_zero two_ne_zero hnune
  have hmulom : ((n : ℂ)) * u * om = 1 / 2 := by
    rw [hom, mul_one_div, div_eq_div_iff h2nu (by norm_num : (2 : ℂ) ≠ 0)]
    ring
  have hfac : ((n : ℂ)) * u * (1 + om) = (n : ℂ) * u + 1 / 2 := by
    rw [mul_add, mul_one, hmulom]
  have habsre : |om.re| ≤ ‖om‖ := Complex.abs_re_le_norm om
  have hone_add_re : 0 < (1 + om).re := by
    have h2 : (1 + om).re = 1 + om.re := by simp
    rw [h2]
    have := abs_le.mp (le_trans habsre homle)
    linarith [this.1]
  have hone_add_ne : (1 : ℂ) + om ≠ 0 := by
    intro h; rw [h] at hone_add_re; simp at hone_add_re
  have harg1 : |((n : ℂ) * u).arg| < Real.pi / 2 := by
    refine Complex.abs_arg_lt_pi_div_two_iff.mpr (Or.inl ?_)
    have hh : ((n : ℂ) * u).re = (n : ℝ) * q := by simp [hure]
    rw [hh]; positivity
  have harg2 : |((1 : ℂ) + om).arg| < Real.pi / 2 :=
    Complex.abs_arg_lt_pi_div_two_iff.mpr (Or.inl hone_add_re)
  have hsplit : Complex.log ((n : ℂ) * u + 1 / 2)
      = Complex.log ((n : ℂ) * u) + Complex.log (1 + om) := by
    rw [← hfac]
    refine (Complex.log_mul_eq_add_log_iff hnune hone_add_ne).mpr ?_
    exact ⟨by linarith [(abs_lt.mp harg1).1, (abs_lt.mp harg2).1],
           le_of_lt (by linarith [(abs_lt.mp harg1).2, (abs_lt.mp harg2).2])⟩
  have hlognu : Complex.log ((n : ℂ) * u) = ((Real.log n : ℝ) : ℂ) + Complex.log u := by
    rw [show ((n : ℂ)) = (((n : ℝ)) : ℂ) by push_cast; ring]
    exact Complex.log_ofReal_mul hnpos hune
  have hmulre : ∀ z : ℂ, ((n : ℂ) * z).re = (n : ℝ) * z.re := by
    intro z
    rw [Complex.mul_re]
    simp
  have hbridge : (u * Complex.log u).re = Zeta2SupScheme.Lterm q w := by
    rw [hu]; exact Zeta2L7Assembly.re_mul_log_eq_Lterm hq
  have hlogncast : (u * (((Real.log (n : ℝ)) : ℝ) : ℂ)).re = q * Real.log (n : ℝ) := by
    rw [Complex.mul_re, hure, Complex.ofReal_re, Complex.ofReal_im]
    ring
  have hdecomp : (((n : ℂ) * u + 1 / 2 - 1 / 2) * Complex.log ((n : ℂ) * u + 1 / 2)).re
      = (n : ℝ) * (q * Real.log n) + (n : ℝ) * Zeta2SupScheme.Lterm q w
        + ((n : ℂ) * (u * Complex.log (1 + om))).re := by
    rw [show ((n : ℂ) * u + 1 / 2 - 1 / 2) = (n : ℂ) * u by ring, hsplit, hlognu,
      show ((n : ℂ) * u) * ((((Real.log n : ℝ)) : ℂ) + Complex.log u + Complex.log (1 + om))
        = (n : ℂ) * (u * (((Real.log n : ℝ)) : ℂ)) + (n : ℂ) * (u * Complex.log u)
          + (n : ℂ) * (u * Complex.log (1 + om)) by ring]
    rw [Complex.add_re, Complex.add_re, hmulre, hmulre, hmulre, hbridge, hlogncast]
  have hlogbd : ‖Complex.log (1 + om)‖ ≤ ‖om‖ + ‖om‖ ^ 2 * (1 - ‖om‖)⁻¹ / 2 := by
    have h := Complex.norm_log_one_add_sub_self_le homlt
    have htri := norm_sub_norm_le (Complex.log (1 + om)) om
    linarith
  have hA : (n : ℝ) * ‖u‖ * ‖om‖ = 1 / 2 := by rw [hnormom]; field_simp
  have hB : (n : ℝ) * ‖u‖ * (‖om‖ ^ 2 * (1 - ‖om‖)⁻¹ / 2) ≤ 5 / 52 := by
    have h1 : (0 : ℝ) < 1 - ‖om‖ := by linarith
    have hEq : (n : ℝ) * ‖u‖ * (‖om‖ ^ 2 * (1 - ‖om‖)⁻¹ / 2)
        = ((n : ℝ) * ‖u‖ * ‖om‖ ^ 2) / (2 * (1 - ‖om‖)) := by
      field_simp
    rw [hEq, div_le_iff₀ (by linarith)]
    have hsq : (n : ℝ) * ‖u‖ * ‖om‖ ^ 2 = 1 / 2 * ‖om‖ := by
      rw [sq, ← mul_assoc, hA]
    rw [hsq]
    linarith
  -- The remainder bound, TWO-SIDED: `|Re| ≤ ‖·‖` costs nothing that `Re ≤ ‖·‖` did not.
  have hrem : |((n : ℂ) * (u * Complex.log (1 + om))).re| ≤ 31 / 52 := by
    have hnorm : ‖(n : ℂ) * (u * Complex.log (1 + om))‖
        = (n : ℝ) * ‖u‖ * ‖Complex.log (1 + om)‖ := by
      rw [show (n : ℂ) * (u * Complex.log (1 + om))
            = ((n : ℂ) * u) * Complex.log (1 + om) by ring, norm_mul, hnormnu]
    have h1 : |((n : ℂ) * (u * Complex.log (1 + om))).re|
        ≤ ‖(n : ℂ) * (u * Complex.log (1 + om))‖ := Complex.abs_re_le_norm _
    have h2 : (n : ℝ) * ‖u‖ * ‖Complex.log (1 + om)‖
        ≤ (n : ℝ) * ‖u‖ * (‖om‖ + ‖om‖ ^ 2 * (1 - ‖om‖)⁻¹ / 2) :=
      mul_le_mul_of_nonneg_left hlogbd (le_of_lt hMpos)
    rw [hnorm] at h1
    nlinarith [hA, hB]
  set z : ℂ := (n : ℂ) * u + 1 / 2 with hz
  have hzre : z.re = (n : ℝ) * q + 1 / 2 := by
    rw [hz, Complex.add_re, hmulre, hure]; simp
  have h23 : 23 / 10 ≤ z.re := by rw [hzre]; linarith
  have hzpos : (0 : ℝ) < z.re := by linarith
  have hb := binet z h23
  have hc1 : 2 / 5 * (1 / z.re ^ 2 + 1 / z.re) ≤ 1 / 4 := by
    have h1 : 1 / z.re ≤ 10 / 23 := by
      rw [div_le_div_iff₀ hzpos (by norm_num)]; linarith
    have h2 : 1 / z.re ^ 2 ≤ 100 / 529 := by
      rw [div_le_div_iff₀ (by positivity) (by norm_num)]; nlinarith
    linarith
  have hb2 : Real.log ‖Complex.Gamma z‖ ≤ ((z - 1 / 2) * Complex.log z).re - z.re
      + 1 / 2 * Real.log (2 * Real.pi) + 1 / 4 := by
    have h := (abs_le.mp hb).2
    linarith [hc1]
  have hb1 : ((z - 1 / 2) * Complex.log z).re - z.re
      + 1 / 2 * Real.log (2 * Real.pi) - 1 / 4 ≤ Real.log ‖Complex.Gamma z‖ := by
    have h := (abs_le.mp hb).1
    linarith [hc1]
  rw [hdecomp, hzre] at hb2 hb1
  rw [abs_le]
  constructor <;> linarith [(abs_le.mp hrem).1, (abs_le.mp hrem).2]

/-- **M1, `lemma4_lower`.**  The mirror of `Zeta2L7Assembly.lemma4_upper`, with exactly the
