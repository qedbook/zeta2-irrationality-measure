    Tendsto (fun M : ℕ => (∑ k ∈ Finset.range M,
        ((z + (k : ℂ) + 1/2) * Complex.log (1 + 1/(z + (k : ℂ))) - 1)).re)
      atTop (𝓝 (z.re - 1/2 * Real.log (2 * Real.pi) + Real.log ‖Complex.Gamma z‖
                 - ((z - 1/2) * Complex.log z).re)) := by
  have hs : ∀ m : ℕ, z ≠ -(m : ℂ) := by
    intro m h
    rw [h] at hz
    simp only [Complex.neg_re, Complex.natCast_re, neg_pos] at hz
    linarith [Nat.cast_nonneg (α := ℝ) m]
  refine Zeta2BinetTie9.binet_remainder z (assembly z hz) ?_ ?_ ?_
  · exact Zeta2BinetTie7.tendsto_P z (Zeta2BinetTie3.tendsto_key z)
      (fun M hM => Zeta2BinetTie4.log_add_sub_log_natCast hz hM)
  · exact Zeta2BinetTie5.tendsto_log_factorial
  · exact Zeta2Binet.tendsto_log_norm_Gamma z hs

/-- **THE EXPLICIT COMPLEX BINET BOUND — C1, closed.**

For `Re z ≥ 23/10`,
`|log‖Γ(z)‖ − Re[(z−½)·Log z] + Re z − ½·log 2π| ≤ (2/5)(1/(Re z)² + 1/Re z)`.

This is the row `zeta2-integral-free.md` §5.3 marks **ABSENT** and "BUILD, HIGH — THE blocker".
It is obtained WITHOUT Binet's first formula and WITHOUT complex Stirling: the tie (above) via the
Gauss limit and natural-number Stirling, and the bound via steps (b′)+(c). -/
theorem binet_bound (z : ℂ) (hz : 23/10 ≤ z.re) :
    |Real.log ‖Complex.Gamma z‖ - ((z - 1/2) * Complex.log z).re + z.re
        - 1/2 * Real.log (2 * Real.pi)|
      ≤ 2/5 * (1/z.re ^ 2 + 1/z.re) := by
  have hz0 : (0 : ℝ) < z.re := by linarith
  have htie := binet_remainder z hz0
  have hval : z.re - 1/2 * Real.log (2 * Real.pi) + Real.log ‖Complex.Gamma z‖
        - ((z - 1/2) * Complex.log z).re
      = Real.log ‖Complex.Gamma z‖ - ((z - 1/2) * Complex.log z).re + z.re
        - 1/2 * Real.log (2 * Real.pi) := by ring
  rw [hval] at htie
  refine le_of_tendsto htie.abs (Filter.Eventually.of_forall fun M => ?_)
  calc |(∑ k ∈ Finset.range M,
          ((z + (k : ℂ) + 1/2) * Complex.log (1 + 1/(z + (k : ℂ))) - 1)).re|
      ≤ ‖∑ k ∈ Finset.range M,
          ((z + (k : ℂ) + 1/2) * Complex.log (1 + 1/(z + (k : ℂ))) - 1)‖ :=
        Complex.abs_re_le_norm _
