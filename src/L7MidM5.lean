  have hsplit : ((z + (M : ℂ) + 1/2) * (Complex.log (z + (M : ℂ)) - Complex.log (M : ℂ))).re
      = ((z + (M : ℂ) + 1/2) * Complex.log (z + (M : ℂ))).re
        - (z.re + (M : ℝ) + 1/2) * Real.log M := by
    have hcoef : (z + (M : ℂ) + 1/2).re = z.re + (M : ℝ) + 1/2 := by simp
    rw [mul_sub, Complex.sub_re,
      Complex.mul_re (z + (M : ℂ) + 1/2) (Complex.log ((M : ℕ) : ℂ)), hre, him, hcoef]
    ring
  rw [hsplit, hper]
  ring

