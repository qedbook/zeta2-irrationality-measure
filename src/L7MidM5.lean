/-- **The assembly identity.** -/
theorem assembly_identity (z : ℂ) (M : ℕ) (hM : 0 < M)
    (hper : (∑ k ∈ Finset.range M,
        ((z + (k : ℂ) + 1/2) * Complex.log (1 + 1/(z + (k : ℂ))) - 1)).re
      = ((z + (M : ℂ) + 1/2) * Complex.log (z + (M : ℂ))).re
        - ((z - 1/2) * Complex.log z).re
        - (∑ j ∈ Finset.range (M + 1), Real.log ‖z + (j : ℂ)‖) - (M : ℝ)) :
    (∑ k ∈ Finset.range M,
        ((z + (k : ℂ) + 1/2) * Complex.log (1 + 1/(z + (k : ℂ))) - 1)).re
      = ((z + (M : ℂ) + 1/2) * (Complex.log (z + (M : ℂ)) - Complex.log (M : ℂ))).re
        - (Real.log (Nat.factorial M) - (((M : ℝ) + 1/2) * Real.log M - (M : ℝ)))
        + (z.re * Real.log M + Real.log (Nat.factorial M)
            - ∑ j ∈ Finset.range (M + 1), Real.log ‖z + (j : ℂ)‖)
        - ((z - 1/2) * Complex.log z).re := by
  have hMpos : (0 : ℝ) < (M : ℝ) := by exact_mod_cast hM
  -- `Log` of a positive natural is real: real part `log M`, imaginary part `0`
  have hre : (Complex.log ((M : ℕ) : ℂ)).re = Real.log (M : ℝ) := by
    rw [Complex.log_re, Complex.norm_natCast]
  have him : (Complex.log ((M : ℕ) : ℂ)).im = 0 := by
    rw [Complex.log_im, show ((M : ℕ) : ℂ) = (((M : ℕ) : ℝ) : ℂ) by push_cast; ring]
    exact Complex.arg_ofReal_of_nonneg hMpos.le
