          ‖(z + (k : ℂ) + 1/2) * Complex.log (1 + 1/(z + (k : ℂ))) - 1‖ :=
        norm_sum_le _ _
    _ ≤ 2/5 * (1/z.re ^ 2 + 1/z.re) :=
        Zeta2BinetC.sum_norm_h_le (fun w hw => Zeta2BinetB2.norm_h_le' w hw) z hz M

