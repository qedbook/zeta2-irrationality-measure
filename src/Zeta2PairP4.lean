kernel adds 88 rationals instead of recomputing `harm 2` at each of the 45 window
terms (row PAIR-VAL, third pass — the same lever `Zeta2MomC.sum_momI` is on the moment side). -/
theorem pnHarm_eq : candidateM.pnHarm 4 = (49117388075451510918789389515392248240515454263021202455889135843267983803369914001989472609160435384989214621888681044356350383954591744000000000000 / 146969 : ℚ) := by
  rw [Zeta2HarmC.pnHarm_shared candidateM (by decide) 4]
  decide +kernel

/-- **`pn 4`, evaluated** — the same literal `hatP_engine` below pins from the hat side. -/
theorem pn_eq : candidateM.pn 4 = (-32687805874306297157279894551933452315199490169511109524526347752919671934527515616709657991323 / 2671126941122562502944000 : ℚ) := by
