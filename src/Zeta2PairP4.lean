and the denominator block unfold to 108 and 45 explicit factors `X + k`, and `ring`
closes it. -/
theorem div_identity : R + candidateM.denPoly 4 * Q = candidateM.numPoly 4 := by
  simp only [Q, R, Member.numPoly, Member.denPoly, candidateM, block, Nat.reduceMul,
    Nat.reduceSub, Nat.reduceAdd, Finset.prod_range_succ, Finset.prod_range_zero, map_natCast,
    map_ofNat, map_neg, map_one]
  push_cast
  ring

theorem R_degree_lt : R.degree < (candidateM.denPoly 4).degree := by
  apply Polynomial.degree_lt_degree
  rw [candidateM.denPoly_natDegree 4]
  have h : R.natDegree ≤ 44 := by rw [R]; compute_degree!
  simp only [candidateM] at h ⊢
  omega

/-- **`Ppol 4` is `Q`** — the first evaluation of `candidateM.Ppol` in the corpus. -/
theorem Ppol_eq : candidateM.Ppol 4 = Q :=
  (Polynomial.div_modByMonic_unique Q R (candidateM.denPoly_monic 4)
    ⟨div_identity, R_degree_lt⟩).1

theorem cell_eq : candidateM.cell 4 = -17 := by decide

/-- `Σ_j Q_j · momI (cell 4) j` — the polynomial half of `pn 4`, the number
`Zeta2DefsCheck.enginePnPoly` only RECORDS.  `sum_momI` replaces the noncomputable `momI`
under the sum by the 64-entry list `momList (-17) 64`, which the kernel
builds ONCE; `simp only [Q, …]` turns each `Q.coeff j` into its literal.  Row PAIR-VAL. -/
