  obtain ⟨R9, hR9, hR9a, hR9b⟩ := residue_spec (q := 6) (a := 9 * r) hp (by omega) (by omega)
  obtain ⟨R5, hR5, hR5a, hR5b⟩ := residue_spec (q := 3) (a := 5 * r) hp (by omega) (by omega)
  obtain ⟨R26, hR26, hR26a, hR26b⟩ := residue_spec (q := 19) (a := 26 * r) hp (by omega) (by omega)
  obtain ⟨R24, hR24, hR24a, hR24b⟩ := residue_spec (q := 18) (a := 24 * r) hp (by omega) (by omega)
  obtain ⟨R22, hR22, hR22a, hR22b⟩ := residue_spec (q := 16) (a := 22 * r) hp (by omega) (by omega)
  unfold kumLoR Mres cb
  rw [hR11, hR13, hR9, hR5, hR26, hR24, hR22]
  simp only [Nat.add_zero, Nat.mod_eq_of_lt hR11b]
  rw [wrap_mod hu hR26b, wrap_mod hu hR24b, wrap_mod hu hR22b]
  split_ifs <;> omega

set_option maxHeartbeats 2000000 in
/-- stratum 80: `[3/4, 13/17)`, φ̃ = 2, the terms above `26n`. -/
theorem polh_S80 {p r u : ℕ} (hp : 0 < p) (hr : r < p) (hu : u < p)
    (hlo : 3 * p ≤ 4 * r) (hhi : 17 * r < 13 * p) :
    2 + 1 ≤ kumHiR p r 0 u + 1 := by
  obtain ⟨R11, hR11, hR11a, hR11b⟩ := residue_spec (q := 8) (a := 11 * r) hp (by omega) (by omega)
  obtain ⟨R13, hR13, hR13a, hR13b⟩ := residue_spec (q := 9) (a := 13 * r) hp (by omega) (by omega)
  obtain ⟨R9, hR9, hR9a, hR9b⟩ := residue_spec (q := 6) (a := 9 * r) hp (by omega) (by omega)
  obtain ⟨R5, hR5, hR5a, hR5b⟩ := residue_spec (q := 3) (a := 5 * r) hp (by omega) (by omega)
  obtain ⟨R15, hR15, hR15a, hR15b⟩ := residue_spec (q := 11) (a := 15 * r) hp (by omega) (by omega)
  obtain ⟨R17, hR17, hR17a, hR17b⟩ := residue_spec (q := 12) (a := 17 * r) hp (by omega) (by omega)
  unfold kumHiR Mres cb
  rw [hR11, hR13, hR9, hR5, hR15, hR17]
  simp only [Nat.add_zero, Nat.mod_eq_of_lt hR11b]
  rw [mod_of_lt_two_mul (a := u + p - 1 - R13) (by omega), mod_of_lt_two_mul (a := u + p - 1 - R15) (by omega),
    mod_of_lt_two_mul (a := u + p - 1 - R17) (by omega)]
  split_ifs <;> omega

