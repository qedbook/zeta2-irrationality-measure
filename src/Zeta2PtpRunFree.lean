/-! ## Piece 1: `[1/15, 1/13)`, `φ̃ = 1`, 1 stratum(s) -/

/-- stratum `[1/15, 1/13)`: floors `⌊13x⌋=0, ⌊9x⌋=0, ⌊5x⌋=0, ⌊11x⌋=0, ⌊4x⌋=0, ⌊2x⌋=0`. -/
theorem bits_p1_1 {p r u : ℕ} (hu : u < p) (hr : r < p)
    (hlo : 1 * p ≤ 15 * r) (hhi : 13 * r < 1 * p) : 1 ≤ bitsR p r u := by
  have hp : 0 < p := by omega
  obtain ⟨A, hA, hA1, hA2⟩ := residue_spec (q := 0) (a := 13 * r) hp (by omega) (by omega)
  obtain ⟨B, hB, hB1, hB2⟩ := residue_spec (q := 0) (a := 9 * r) hp (by omega) (by omega)
  obtain ⟨C, hC, hC1, hC2⟩ := residue_spec (q := 0) (a := 5 * r) hp (by omega) (by omega)
  obtain ⟨E, hE, hE1, hE2⟩ := residue_spec (q := 0) (a := 11 * r) hp (by omega) (by omega)
  obtain ⟨D, hD, hD1, hD2⟩ := residue_spec (q := 0) (a := 4 * r) hp (by omega) (by omega)
  obtain ⟨F, hF, hF1, hF2⟩ := residue_spec (q := 0) (a := 2 * r) hp (by omega) (by omega)
  unfold bitsR
  rw [bit1_abstract hu hA hD, bit2_abstract hu hB hF, bit3_abstract hu hC,
    bit4_abstract hu hr hE]
  split_ifs <;> omega

theorem noShort_p1_1 {n p : ℕ} (hp : 0 < p)
    (hlo : 1 * p ≤ 15 * (n % p)) (hhi : 13 * (n % p) < 1 * p) : NoShort p n 1 :=
  noShort_of_bits hp fun _ hu => bits_p1_1 hu (Nat.mod_lt _ hp) hlo hhi

theorem phiT_piece1 {x : ℚ} (h1 : 1 / 15 ≤ x) (h2 : x < 1 / 13) : phiT x = 1 := by
  have h := phiT_of_mem (a := 1 / 15) (b := 1 / 13) (v := 1) (by decide +kernel) h1 h2
  exact h

theorem phiT_piece1_res {n p : ℕ} (hp : 0 < p) (hlo : 1 * p ≤ 15 * (n % p))
    (hhi : 13 * (n % p) < 1 * p) : phiT (Int.fract ((n : ℚ) / (p : ℚ))) = 1 := by
  refine phiT_piece1 ?_ ?_
  · have h := (fract_ge_iff n p 1 15 hp (by norm_num)).2 (by omega)
    exact_mod_cast h
  · have h := (fract_lt_iff n p 1 13 hp (by norm_num)).2 (by omega)
    exact_mod_cast h

/-- **Piece 1 `[1/15, 1/13)` for the harmonic side**, termwise on its 1 stratum(s). -/
theorem piece1_blocks {p n : ℕ} (hp : p ∈ phiWindow n) (hlo : 1 * p ≤ 15 * (n % p))
    (hhi : 13 * (n % p) < 1 * p) (t : ℕ) :
    (p : ℤ) ^ (phiT (Int.fract ((n : ℚ) / (p : ℚ)))) ∣ blockSum n p t := by
  have hp0 := (prime_of_mem_phiWindow hp).pos
  rw [phiT_piece1_res hp0 hlo hhi]
  exact blockSum_dvd_of_noShort hp (noShort_p1_1 hp0 (by omega) (by omega)) t


