section From_Zeta2Binet


open Filter Complex Nat
open scoped Topology

namespace Zeta2Binet

/-- **Step (a), part 1.** The Gauss limit survives `log ‖·‖`. -/
theorem tendsto_log_norm_gammaSeq (s : ℂ) (hs : ∀ m : ℕ, s ≠ -(m : ℂ)) :
    Tendsto (fun n : ℕ => Real.log ‖Complex.GammaSeq s n‖) atTop
      (𝓝 (Real.log ‖Complex.Gamma s‖)) := by
  have h0 : Complex.Gamma s ≠ 0 := Complex.Gamma_ne_zero hs
  have h1 : Tendsto (fun n : ℕ => ‖Complex.GammaSeq s n‖) atTop (𝓝 ‖Complex.Gamma s‖) :=
    (Complex.GammaSeq_tendsto_Gamma s).norm
  have h2 : ‖Complex.Gamma s‖ ≠ 0 := norm_ne_zero_iff.mpr h0
  exact (Real.continuousAt_log h2).tendsto.comp h1

/-- **Step (a), part 2.** The explicit expansion of the log-modulus of `GammaSeq`.
`GammaSeq s n = n ^ s * n ! / ∏ j ∈ range (n+1), (s + j)`, so for `n ≥ 1`
`log ‖GammaSeq s n‖ = s.re * log n + log n ! - ∑ j ∈ range (n+1), log ‖s + j‖`. -/
theorem log_norm_gammaSeq (s : ℂ) (hs : ∀ m : ℕ, s ≠ -(m : ℂ)) {n : ℕ} (hn : 0 < n) :
    Real.log ‖Complex.GammaSeq s n‖
      = s.re * Real.log n + Real.log (Nat.factorial n)
        - ∑ j ∈ Finset.range (n + 1), Real.log ‖s + (j : ℂ)‖ := by
  have hnpos : (0 : ℝ) < (n : ℝ) := by exact_mod_cast hn
  have hne : ∀ j ∈ Finset.range (n + 1), s + (j : ℂ) ≠ 0 := by
    intro j _ h
    exact hs j (by linear_combination h)
  have hnum : ‖(n : ℂ) ^ s‖ = (n : ℝ) ^ s.re := by
    have hcast : ((n : ℕ) : ℂ) = (((n : ℕ) : ℝ) : ℂ) := by push_cast; ring
    rw [hcast]
    exact Complex.norm_cpow_eq_rpow_re_of_pos hnpos s
  have hden : (∏ j ∈ Finset.range (n + 1), ‖s + (j : ℂ)‖) ≠ 0 :=
    Finset.prod_ne_zero_iff.mpr (fun j hj => norm_ne_zero_iff.mpr (hne j hj))
  have h1 : ‖Complex.GammaSeq s n‖
      = ((n : ℝ) ^ s.re * (Nat.factorial n : ℝ))
        / ∏ j ∈ Finset.range (n + 1), ‖s + (j : ℂ)‖ := by
    rw [Complex.GammaSeq, norm_div, norm_mul, hnum, norm_prod]
    simp
  rw [h1, Real.log_div (by positivity) hden, Real.log_mul (by positivity) (by positivity),
    Real.log_rpow hnpos,
    Real.log_prod (fun j hj => norm_ne_zero_iff.mpr (hne j hj))]

/-- **Step (a), assembled — the deliverable of this probe.**
`log ‖Γ(s)‖` is the limit of an explicit REAL sequence with no branch cut anywhere:
`log ‖Γ(s)‖ = lim_n [ s.re · log n + log n! − ∑_{j≤n} log ‖s + j‖ ]`.

This is the foundation the explicit Binet-class bound is built on, and it is reached without
Binet's first formula — i.e. without any integral representation of `μ`, which is the thing
Mathlib does not have. -/
theorem tendsto_log_norm_Gamma (s : ℂ) (hs : ∀ m : ℕ, s ≠ -(m : ℂ)) :
    Tendsto (fun n : ℕ => s.re * Real.log n + Real.log (Nat.factorial n)
        - ∑ j ∈ Finset.range (n + 1), Real.log ‖s + (j : ℂ)‖)
      atTop (𝓝 (Real.log ‖Complex.Gamma s‖)) := by
  apply (tendsto_log_norm_gammaSeq s hs).congr'
  filter_upwards [eventually_gt_atTop 0] with n hn
  exact log_norm_gammaSeq s hs hn

end Zeta2Binet
end From_Zeta2Binet

section From_Zeta2BinetB2


open Complex

namespace Zeta2BinetB2

/-- The exact algebraic head, as in step (b). -/
theorem taylor_head (w : ℂ) (hw : w ≠ 0) :
    (w + 1/2) * (logTaylor 4 (1/w)) - 1 = 1 / (12 * w^2) + 1 / (6 * w^3) := by
  have h4 : logTaylor 4 (1/w) = (1/w) - (1/w)^2/2 + (1/w)^3/3 := by
    simp [logTaylor, Finset.sum_range_succ]
    ring
  rw [h4]
  field_simp
  ring

/-- **Step (b').** `‖h(w)‖ ≤ 2/(5‖w‖²)` for `‖w‖ ≥ 23/10` — the form step (c) consumes. -/
theorem norm_h_le' (w : ℂ) (hw : 23/10 ≤ ‖w‖) :
    ‖(w + 1/2) * Complex.log (1 + 1/w) - 1‖ ≤ 2 / (5 * ‖w‖ ^ 2) := by
  have hrpos : (0 : ℝ) < ‖w‖ := by linarith
  have hw0 : w ≠ 0 := norm_pos_iff.mp hrpos
  have hz : ‖(1 / w : ℂ)‖ = 1 / ‖w‖ := by rw [norm_div, norm_one]
  have hzlt : ‖(1 / w : ℂ)‖ < 1 := by
    rw [hz, div_lt_one hrpos]; linarith
  have hrem := Complex.norm_log_sub_logTaylor_le 3 hzlt
  have hsplit : (w + 1/2) * Complex.log (1 + 1/w) - 1
      = (1 / (12 * w ^ 2) + 1 / (6 * w ^ 3))
        + (w + 1/2) * (Complex.log (1 + 1/w) - logTaylor 4 (1/w)) := by
    rw [← taylor_head w hw0]; ring
  rw [hsplit]
  refine (norm_add_le _ _).trans ?_
  have hhead : ‖(1 / (12 * w ^ 2) + 1 / (6 * w ^ 3) : ℂ)‖
      ≤ 1 / (12 * ‖w‖ ^ 2) + 1 / (6 * ‖w‖ ^ 3) := by
    refine (norm_add_le _ _).trans (le_of_eq ?_)
    rw [norm_div, norm_div, norm_one, norm_mul, norm_mul, norm_pow, norm_pow]
    norm_num
  have htail : ‖(w + 1/2) * (Complex.log (1 + 1/w) - logTaylor 4 (1/w))‖
      ≤ (‖w‖ + 1/2) * (‖w‖⁻¹ ^ 4 * (1 - ‖w‖⁻¹)⁻¹ / 4) := by
    rw [norm_mul]
    refine mul_le_mul ((norm_add_le _ _).trans (by norm_num)) ?_ (norm_nonneg _) (by positivity)
    calc ‖Complex.log (1 + 1/w) - logTaylor 4 (1/w)‖
        ≤ ‖(1/w : ℂ)‖ ^ (3 + 1) * (1 - ‖(1/w : ℂ)‖)⁻¹ / (3 + 1) := hrem
      _ = ‖w‖⁻¹ ^ 4 * (1 - ‖w‖⁻¹)⁻¹ / 4 := by rw [hz]; norm_num [one_div]
  refine (add_le_add hhead htail).trans ?_
  set r := ‖w‖ with hrdef
  have hrm1 : (0 : ℝ) < r - 1 := by linarith
  have hinv : r⁻¹ ^ 4 * (1 - r⁻¹)⁻¹ / 4 = 1 / (4 * r ^ 3 * (r - 1)) := by field_simp
  rw [hinv]
  -- Clearing `120 r³ (r−1) > 0` leaves exactly `38r² − 88r + 5 ≥ 0`.
  have ident : 2 / (5 * r ^ 2)
      - (1 / (12 * r ^ 2) + 1 / (6 * r ^ 3) + (r + 1/2) * (1 / (4 * r ^ 3 * (r - 1))))
      = (38 * r ^ 2 - 88 * r + 5) / (120 * r ^ 3 * (r - 1)) := by
    field_simp
    ring
  have hnum : (0 : ℝ) ≤ 38 * r ^ 2 - 88 * r + 5 := by
    nlinarith [sq_nonneg (r - 23/10), (by linarith : (0:ℝ) ≤ r - 23/10)]
  have hquot : (0 : ℝ) ≤ (38 * r ^ 2 - 88 * r + 5) / (120 * r ^ 3 * (r - 1)) :=
    div_nonneg hnum (by positivity)
  linarith [ident, hquot]

end Zeta2BinetB2
end From_Zeta2BinetB2

section From_Zeta2BinetC


open Complex

namespace Zeta2BinetC

/-- The telescoping tail bound: `∑_{k≤N} 1/(x+k)² ≤ 1/x² + 1/x − 1/(x+N)` for `x > 0`.
No integral comparison — the `k ≥ 1` terms telescope. -/
theorem sum_inv_sq_le (x : ℝ) (hx : 0 < x) (N : ℕ) :
    ∑ k ∈ Finset.range (N + 1), 1 / (x + k) ^ 2 ≤ 1 / x ^ 2 + 1 / x - 1 / (x + N) := by
  induction N with
  | zero => simp
  | succ n ih =>
    rw [Finset.sum_range_succ]
    have hn : (0 : ℝ) < x + n := by positivity
    have hn1 : (0 : ℝ) < x + n + 1 := by linarith
    have key : 1 / (x + n) - 1 / (x + n + 1) = 1 / ((x + n) * (x + n + 1)) := by
      field_simp
      ring
    have step : 1 / (x + n + 1) ^ 2 ≤ 1 / (x + n) - 1 / (x + n + 1) := by
      rw [key]
      apply one_div_le_one_div_of_le (by positivity)
      nlinarith
    have hassoc : x + ((n : ℝ) + 1) = x + n + 1 := by ring
    push_cast
    rw [hassoc]
    linarith

/-- The same bound over `range N` for every `N`, including `N = 0`. -/
theorem sum_inv_sq_le' (x : ℝ) (hx : 0 < x) (N : ℕ) :
    ∑ k ∈ Finset.range N, 1 / (x + k) ^ 2 ≤ 1 / x ^ 2 + 1 / x := by
  cases N with
  | zero =>
    simp
    positivity
  | succ n =>
    have h := sum_inv_sq_le x hx n
    have hpos : (0 : ℝ) < 1 / (x + n) := by positivity
    linarith

/-- **Step (c).** Given the per-term bound of step (b'), the partial sums of the Binet series
`∑ h(z+k)` are bounded UNIFORMLY in `N` by `(2/5)(1/x² + 1/x)`, `x = Re z ≥ 23/10`.

Stated with (b') as a hypothesis so the two steps compose without either file importing the
other; `Zeta2BinetB2.norm_h_le'` discharges it verbatim. -/
theorem sum_norm_h_le
    (hb' : ∀ w : ℂ, 23/10 ≤ ‖w‖ →
      ‖(w + 1/2) * Complex.log (1 + 1/w) - 1‖ ≤ 2 / (5 * ‖w‖ ^ 2))
    (z : ℂ) (hz : 23/10 ≤ z.re) (N : ℕ) :
    ∑ k ∈ Finset.range N, ‖(z + (k : ℂ) + 1/2) * Complex.log (1 + 1/(z + (k : ℂ))) - 1‖
      ≤ 2 / 5 * (1 / z.re ^ 2 + 1 / z.re) := by
  have hxpos : (0 : ℝ) < z.re := by linarith
  -- each term, bounded by the real sequence
  have hterm : ∀ k ∈ Finset.range N,
      ‖(z + (k : ℂ) + 1/2) * Complex.log (1 + 1/(z + (k : ℂ))) - 1‖
        ≤ 2 / 5 * (1 / (z.re + k) ^ 2) := by
    intro k _
    have hre : (z + (k : ℂ)).re = z.re + k := by simp
    have hnorm : z.re + (k : ℝ) ≤ ‖z + (k : ℂ)‖ := by
      rw [← hre]; exact Complex.re_le_norm _
    have hk : (23 : ℝ)/10 ≤ ‖z + (k : ℂ)‖ := by
      have : (0 : ℝ) ≤ (k : ℝ) := Nat.cast_nonneg k
      linarith
    have hb := hb' (z + (k : ℂ)) hk
    have hpos : (0 : ℝ) < z.re + k := by positivity
    have hne : (z.re + (k : ℝ)) ≠ 0 := ne_of_gt hpos
    calc ‖(z + (k : ℂ) + 1/2) * Complex.log (1 + 1/(z + (k : ℂ))) - 1‖
        ≤ 2 / (5 * ‖z + (k : ℂ)‖ ^ 2) := hb
      _ ≤ 2 / (5 * (z.re + k) ^ 2) := by
          apply div_le_div_of_nonneg_left (by norm_num) (by positivity)
          nlinarith [hnorm, hpos.le]
      _ = 2 / 5 * (1 / (z.re + k) ^ 2) := by field_simp
  refine (Finset.sum_le_sum hterm).trans ?_
  rw [← Finset.mul_sum]
  have := sum_inv_sq_le' z.re hxpos N
  nlinarith [this]

end Zeta2BinetC
end From_Zeta2BinetC

section From_Zeta2BinetTie2


open Complex

namespace Zeta2BinetTie2

/-- On the right half-plane the principal log splits across `1 + 1/w`.
(Proved in `Zeta2BinetTie.lean`; repeated here so the files compose without importing.) -/
theorem log_one_add_inv {w : ℂ} (hw : 0 < w.re) :
    Complex.log (1 + 1 / w) = Complex.log (w + 1) - Complex.log w := by
  have hw0 : w ≠ 0 := by
    intro h; rw [h] at hw; simp at hw
  have hw1 : w + 1 ≠ 0 := by
    intro h
    have : (w + 1).re = 0 := by rw [h]; simp
    simp only [Complex.add_re, Complex.one_re] at this
    linarith
  have harg : |w.arg| < Real.pi / 2 := Complex.abs_arg_lt_pi_div_two_iff.mpr (Or.inl hw)
  have harg1 : |(w + 1).arg| < Real.pi / 2 := by
    refine Complex.abs_arg_lt_pi_div_two_iff.mpr (Or.inl ?_)
    simp only [Complex.add_re, Complex.one_re]
    linarith
  have hinv : Complex.log w⁻¹ = -Complex.log w := by
    refine Complex.log_inv w ?_
    intro h
    rw [h] at harg
    rw [abs_of_nonneg Real.pi_pos.le] at harg
    linarith [Real.pi_pos]
  have hinvarg : |(w⁻¹).arg| < Real.pi / 2 := by
    rw [Complex.abs_arg_inv]; exact harg
  have hsplit : Complex.log ((w + 1) * w⁻¹) = Complex.log (w + 1) + Complex.log w⁻¹ := by
    refine Complex.log_mul hw1 (inv_ne_zero hw0) ?_
    rw [Set.mem_Ioc]
    rw [abs_lt] at harg1 hinvarg
    constructor <;> linarith
  have hrw : (1 : ℂ) + 1 / w = (w + 1) * w⁻¹ := by
    field_simp
  rw [hrw, hsplit, hinv]
  ring

/-- **The Abel identity.** The telescoping Binet sum in closed form. -/
theorem abel_sum (z : ℂ) (hz : 0 < z.re) (N : ℕ) :
    ∑ k ∈ Finset.range (N + 1), ((z + (k : ℂ) + 1/2) * Complex.log (1 + 1/(z + (k : ℂ))) - 1)
      = (z + ((N : ℂ) + 1) - 1/2) * Complex.log (z + ((N : ℂ) + 1))
        - (z + 1/2) * Complex.log z
        - (∑ m ∈ Finset.Ico 1 (N + 1), Complex.log (z + (m : ℂ))) - ((N : ℂ) + 1) := by
  induction N with
  | zero =>
    simp only [zero_add, Finset.range_one, Finset.sum_singleton, Nat.cast_zero, add_zero,
      Finset.Ico_self, Finset.sum_empty, sub_zero]
    rw [log_one_add_inv hz]
    ring
  | succ n ih =>
    have hnn : (0 : ℝ) ≤ (n : ℝ) := Nat.cast_nonneg n
    have hw : (0 : ℝ) < (z + ((n : ℂ) + 1)).re := by
      simp only [Complex.add_re, Complex.natCast_re, Complex.one_re]
      linarith
    have hsplit := log_one_add_inv hw
    have hIco : (∑ m ∈ Finset.Ico 1 (n + 1 + 1), Complex.log (z + (m : ℂ)))
        = (∑ m ∈ Finset.Ico 1 (n + 1), Complex.log (z + (m : ℂ)))
          + Complex.log (z + ((n : ℂ) + 1)) := by
      rw [Finset.sum_Ico_succ_top (by omega : (1 : ℕ) ≤ n + 1)]
      push_cast
      ring
    rw [Finset.sum_range_succ, ih, hIco]
    push_cast
    rw [hsplit]
    ring

end Zeta2BinetTie2
end From_Zeta2BinetTie2

section From_Zeta2BinetTie3


open Complex Filter
open scoped Topology

namespace Zeta2BinetTie3

/-- `Log (1 + z/N) → 0` along the naturals.

`z / N → 0` is Mathlib's `tendsto_const_div_atTop_nhds_zero_nat`, which holds in any
`DivisionSemiring` with `CharZero` and the two continuity instances — `ℂ` among them — so it
is used here directly.  This file previously carried a `tendsto_div_natCast` wrapper that
re-proved it at `ℂ` via `tendsto_zero_iff_norm_tendsto_zero`; the detour was unnecessary. -/
theorem tendsto_log_one_add (z : ℂ) :
    Tendsto (fun N : ℕ => Complex.log (1 + z / (N : ℂ))) atTop (𝓝 0) := by
  have h1 : Tendsto (fun N : ℕ => 1 + z / (N : ℂ)) atTop (𝓝 1) := by
    simpa using (tendsto_const_nhds (x := (1 : ℂ))).add
      (tendsto_const_div_atTop_nhds_zero_nat z)
  have hslit : (1 : ℂ) ∈ Complex.slitPlane := by simp
  simpa using h1.clog hslit

/-- **The tie's remaining limit.** `(z + N + 1/2) · Log(1 + z/N) → z`. -/
theorem tendsto_key (z : ℂ) :
    Tendsto (fun N : ℕ => (z + (N : ℂ) + 1/2) * Complex.log (1 + z / (N : ℂ)))
      atTop (𝓝 z) := by
  -- the `N · Log(1 + z/N)` part, straight from Mathlib
  have hg : Tendsto (fun N : ℕ => (N : ℂ) * (z / (N : ℂ))) atTop (𝓝 z) := by
    apply tendsto_nhds_of_eventually_eq
    filter_upwards [eventually_ne_atTop 0] with N hN
    have : ((N : ℂ)) ≠ 0 := Nat.cast_ne_zero.mpr hN
    field_simp
  have h1 : Tendsto (fun N : ℕ => (N : ℂ) * Complex.log (1 + z / (N : ℂ))) atTop (𝓝 z) :=
    Complex.tendsto_nat_mul_log_one_add_of_tendsto hg
  -- the residual `(z + 1/2) · Log(1 + z/N)` vanishes
  have h2 : Tendsto (fun N : ℕ => (z + 1/2) * Complex.log (1 + z / (N : ℂ)))
      atTop (𝓝 0) := by
    simpa using (tendsto_log_one_add z).const_mul (z + 1/2)
  have hsum := h1.add h2
  rw [add_zero] at hsum
  refine hsum.congr fun N => ?_
  ring

end Zeta2BinetTie3
end From_Zeta2BinetTie3

section From_Zeta2BinetTie4


open Complex

namespace Zeta2BinetTie4

/-- **The bridge.** For `Re z > 0` and `N ≥ 1`, `Log(z+N) − Log N = Log(1 + z/N)`. -/
theorem log_add_sub_log_natCast {z : ℂ} (hz : 0 < z.re) {N : ℕ} (hN : 0 < N) :
    Complex.log (z + (N : ℂ)) - Complex.log (N : ℂ) = Complex.log (1 + z / (N : ℂ)) := by
  have hNpos : (0 : ℝ) < (N : ℝ) := by exact_mod_cast hN
  have hNC : ((N : ℕ) : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
  have hare : (0 : ℝ) < (z + (N : ℂ)).re := by
    simp only [Complex.add_re, Complex.natCast_re]
    linarith
  have ha0 : z + (N : ℂ) ≠ 0 := by
    intro h
    rw [h] at hare
    simp at hare
  -- `arg N = 0` because `N` is a positive real
  have hargN : ((N : ℕ) : ℂ).arg = 0 := by
    rw [show ((N : ℕ) : ℂ) = (((N : ℕ) : ℝ) : ℂ) by push_cast; ring]
    exact Complex.arg_ofReal_of_nonneg hNpos.le
  have hargNinv : ((N : ℕ) : ℂ)⁻¹.arg = 0 := by
    rw [Complex.arg_inv, hargN]
    norm_num
    intro h
    linarith [Real.pi_pos]
  have harga : |(z + (N : ℂ)).arg| < Real.pi / 2 :=
