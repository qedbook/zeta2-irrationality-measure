/-- **M1, `lemma4_denom`.**  `zeta2-l7-proof.md` Lemma 4(2), the offset-3/2 LOWER bound that
Theorem 5's eighth (denominator) `Γ` needs — with the write-up's `q ≥ 20` GONE.  Probe P7
(`Complex.Gamma_add_one`) supplies `‖Γ(nu+3/2)‖ ≥ (nq + 1/2)·‖Γ(nu+1/2)‖`, and `nq + 1/2 ≥ 1`
under the same `9/5 ≤ n q` the upper half already has, so the extra factor only helps.  The
write-up's constant is `−1`; this is `−8/5`, weaker by `3/5` and free — every `O(1)` here lands
in `C_B`. -/
theorem lemma4_denom {n : ℕ} (hn : 1 ≤ n) {q w : ℝ} (hq : 0 < q) (hnq : 9 / 5 ≤ (n : ℝ) * q) :
    (n : ℝ) * (q * Real.log n + Zeta2SupScheme.Lterm q w - q)
        + 1 / 2 * Real.log (2 * Real.pi) - 8 / 5
      ≤ Real.log ‖Complex.Gamma ((n : ℂ) * ((q : ℂ) + (w : ℂ) * Complex.I) + 3 / 2)‖ := by
  have hlow := lemma4_lower (w := w) hn hq hnq
  have hge := L7Mid.norm_Gamma_offset_three_halves hn (q := q) (w := w) hq
  have hre : ((n : ℂ) * ((q : ℂ) + (w : ℂ) * Complex.I) + 1 / 2).re = (n : ℝ) * q + 1 / 2 := by
    simp [Complex.add_re, Complex.mul_re]
  have hGne : Complex.Gamma ((n : ℂ) * ((q : ℂ) + (w : ℂ) * Complex.I) + 1 / 2) ≠ 0 := by
    refine Complex.Gamma_ne_zero_of_re_pos ?_
    rw [hre]; linarith
  have hGpos : 0 < ‖Complex.Gamma ((n : ℂ) * ((q : ℂ) + (w : ℂ) * Complex.I) + 1 / 2)‖ :=
    norm_pos_iff.mpr hGne
  have hmono : ‖Complex.Gamma ((n : ℂ) * ((q : ℂ) + (w : ℂ) * Complex.I) + 1 / 2)‖
      ≤ ‖Complex.Gamma ((n : ℂ) * ((q : ℂ) + (w : ℂ) * Complex.I) + 3 / 2)‖ := by
    nlinarith [hge, hGpos, hnq]
  exact hlow.trans (Real.log_le_log hGpos hmono)

/-- **EDGE (`LEAN.md` §5), the binding instance.**  M1 is applied at its tightest at `n = 1`,
`q = B₃ = σ̃ − 4 = 1.8008704…`, which clears `9/5` by 0.048 % — tighter than the `q ≥ 20` row
§3d retires, and the one margin `zeta2-l7-proof.md` §16.4 still owns.  Discharged here rather
than asserted, so a `σ̃` that stopped clearing it would red this file instead of silently
invalidating M4. -/
theorem hyp_at_B3 :
    0 < Zeta2SupScheme.sigT - 4 ∧ (9 : ℝ) / 5 ≤ ((1 : ℕ) : ℝ) * (Zeta2SupScheme.sigT - 4) := by
  constructor <;> norm_num [Zeta2SupScheme.sigT]

example (w : ℝ) := lemma4_lower (n := 1) (w := w) le_rfl hyp_at_B3.1 hyp_at_B3.2

example (w : ℝ) := lemma4_denom (n := 1) (w := w) le_rfl hyp_at_B3.1 hyp_at_B3.2

/-- **The kill for that edge (rung 0: a check that cannot go red attests nothing).**  `29/5` is
EXACTLY the boundary: at `σ = 29/5` the side condition holds with equality, and one part in a
million below that it FAILS at `n = 1`.  So `zeta2-l7-proof.md` §16.4's surviving low-side
constraint is real, and `lemma4_lower`'s `9/5 ≤ n q` cannot be dropped. -/
theorem sigma_low_edge :
    (9 : ℝ) / 5 ≤ ((1 : ℕ) : ℝ) * (29 / 5 - 4)
      ∧ ¬ ((9 : ℝ) / 5 ≤ ((1 : ℕ) : ℝ) * (29 / 5 - 1 / 1000000 - 4)) := by
  constructor <;> norm_num

/-! ## §M2. `H_n` in the reflected form — the DEFINITION, per pin P4 -/

/-- L7 §1's `Π(n) = (11n)! / ((13n)! (9n)! (5n)!)`. -/
noncomputable def Pi_n (n : ℕ) : ℝ :=
  (Nat.factorial (11 * n) : ℝ)
    / ((Nat.factorial (13 * n) : ℝ) * (Nat.factorial (9 * n) : ℝ) * (Nat.factorial (5 * n) : ℝ))

/-- L7 §1's numerator shift `a₁ = 13n + 1`. -/
def a₁ (n : ℕ) : ℕ := 13 * n + 1
/-- L7 §1's numerator shift `a₂ = 11n + 1`. -/
def a₂ (n : ℕ) : ℕ := 11 * n + 1
/-- L7 §1's numerator shift `a₃ = 9n + 1` — the SMALLEST, and the one that decides the left
edge of the strip. -/
def a₃ (n : ℕ) : ℕ := 9 * n + 1
/-- L7 §1's numerator shift `a₄ = 15n + 1`. -/
def a₄ (n : ℕ) : ℕ := 15 * n + 1
/-- L7 §1's denominator shift `b₁ = 1`; reflected. -/
def b₁ (_n : ℕ) : ℕ := 1
/-- L7 §1's denominator shift `b₂ = 2n + 1`; reflected. -/
def b₂ (n : ℕ) : ℕ := 2 * n + 1
/-- L7 §1's denominator shift `b₃ = 4n + 1` — the LARGEST of the three reflected ones, and the
one that decides the right edge of the strip. -/
def b₃ (n : ℕ) : ℕ := 4 * n + 1
/-- L7 §1's denominator shift `b₄ = 26n + 2`.  This is the one `Γ` that stays in the
denominator; `Complex.differentiable_one_div_Gamma` is global, so it costs no side condition. -/
def b₄ (n : ℕ) : ℕ := 26 * n + 2

/-- **`H_n`, DEFINED in the reflected form — `zeta2-l7-middle.md` pin P4.**

This is the load-bearing choice of the whole row.  Written the write-up's way,
`H_n = Π(n)·R_n(t)·(π/sin πt)²`, the definition divides by `sin` and carries a double pole at
every negative integer, and recovering analyticity on the strip needs Lemma 9's pole census plus
a removable-singularity theorem.  Written THIS way — three reflections already applied via
`L7Mid.kernel_collapse`, which turns the kernel's two denominator sines into one NUMERATOR
sine — every factor is differentiable on the closed strip and there is nothing to remove.
`Hn_eq_kernel_form` below is what connects the two, off the integers (a null set on any
vertical line).

The leading sign is `(-1)^(b₁+b₂+b₃) = (-1)^(6n+3) = -1`, the same for every `n`. -/
noncomputable def Hn (n : ℕ) (t : ℂ) : ℂ :=
  -((Pi_n n : ℂ) / (Real.pi : ℂ))
    * Complex.sin ((Real.pi : ℂ) * t)
    * (Complex.Gamma (t + (a₁ n : ℂ)) * Complex.Gamma (t + (a₂ n : ℂ))
        * Complex.Gamma (t + (a₃ n : ℂ)) * Complex.Gamma (t + (a₄ n : ℂ)))
    * (Complex.Gamma (1 - (t + (b₁ n : ℂ))) * Complex.Gamma (1 - (t + (b₂ n : ℂ)))
        * Complex.Gamma (1 - (t + (b₃ n : ℂ))))
    * (Complex.Gamma (t + (b₄ n : ℂ)))⁻¹

/-- **M2, the collapse identity, executed on the DEFINITION.**  Off the integers, the reflected
`Hn` is the write-up's `Π(n) · R_n(t) · (π / sin π t)²`.  The hypothesis `sin(π t) ≠ 0` is all
that survives of `zeta2-l7-proof.md` Lemma 3.2's odd-denominator separation: a non-vanishing
remark carrying no constant, in place of a quantitative bound carrying `log(1 + q̃²) ≤ 33`. -/
theorem Hn_eq_kernel_form (n : ℕ) (t : ℂ) (ht : Complex.sin ((Real.pi : ℂ) * t) ≠ 0) :
    Hn n t = (Pi_n n : ℂ)
        * (Complex.Gamma (t + (a₁ n : ℂ)) * Complex.Gamma (t + (a₂ n : ℂ))
            * Complex.Gamma (t + (a₃ n : ℂ)) * Complex.Gamma (t + (a₄ n : ℂ)))
        * ((Complex.Gamma (t + (b₁ n : ℂ)))⁻¹ * (Complex.Gamma (t + (b₂ n : ℂ)))⁻¹
            * (Complex.Gamma (t + (b₃ n : ℂ)))⁻¹ * (Complex.Gamma (t + (b₄ n : ℂ)))⁻¹)
        * ((Real.pi : ℂ) / Complex.sin ((Real.pi : ℂ) * t)) ^ 2 := by
  have hodd : Odd (b₁ n + b₂ n + b₃ n) := by
    simp only [b₁, b₂, b₃, Nat.odd_iff]
    omega
  have hcol := L7Mid.kernel_collapse t (b₁ n) (b₂ n) (b₃ n) ht
  rw [hodd.neg_one_pow] at hcol
  simp only [Hn]
  linear_combination (-(Pi_n n : ℂ)
    * (Complex.Gamma (t + (a₁ n : ℂ)) * Complex.Gamma (t + (a₂ n : ℂ))
        * Complex.Gamma (t + (a₃ n : ℂ)) * Complex.Gamma (t + (a₄ n : ℂ)))
    * (Complex.Gamma (t + (b₄ n : ℂ)))⁻¹) * hcol

/-- The closed strip of `zeta2-l7-proof.md` Lemma 9: `−σn − 1/2 ≤ Re t ≤ −4n − 1/2`. -/
def Strip (n : ℕ) (σ : ℝ) : Set ℂ :=
  {t : ℂ | -σ * (n : ℝ) - 1 / 2 ≤ t.re ∧ t.re ≤ -4 * (n : ℝ) - 1 / 2}

/-- The reflected `Γ`-factors of `Hn` are differentiable wherever `Re(1 − (t + a)) > 0`.  The
mirror of probe P5's `L7Mid.differentiableOn_Gamma_shift`, which only covers `t ↦ Γ(t + a)`. -/
theorem differentiableOn_Gamma_reflect (a : ℂ) :
    DifferentiableOn ℂ (fun t : ℂ => Complex.Gamma (1 - (t + a)))
      {t : ℂ | 0 < (1 - (t + a)).re} := by
  intro t ht
  refine DifferentiableAt.differentiableWithinAt ?_
  have hlin : DifferentiableAt ℂ (fun t : ℂ => 1 - (t + a)) t :=
    (differentiableAt_const (1 : ℂ)).sub (differentiableAt_id.add_const a)
  refine (Complex.differentiableAt_Gamma _ ?_).comp t hlin
  intro m hm
  simp only [Set.mem_ofPred_eq] at ht
  rw [hm] at ht
  simp only [Complex.neg_re, Complex.natCast_re] at ht
  linarith [Nat.cast_nonneg (α := ℝ) m]

/-- **M2, MANIFEST ANALYTICITY — `zeta2-l7-middle.md` §3b, executed.**  `Hn` is differentiable
on the CLOSED strip, for every `n` and every `σ ≤ 9`, with no pole census, no residue count and
no removable-singularity theorem.  The four numerator `Γ`'s have `Re ≥ (9 − σ)n + 1/2 > 0`
(this is where `σ ≤ 9` is spent, and `a₃ = 9n+1` is the binding one); the three reflected `Γ`'s
have `Re ≥ 1/2 > 0` (binding at the right edge, `b₃ = 4n+1`); `(Γ(t+b₄))⁻¹` needs nothing at
all; `sin` is entire.

Note what is NOT a hypothesis: `1 ≤ n`.  At `n = 0` the strip degenerates to the single line
`Re t = −1/2` and every bound above still clears by exactly `1/2` — checked below. -/
theorem differentiableOn_Hn (n : ℕ) {σ : ℝ} (hσ : σ ≤ 9) :
    DifferentiableOn ℂ (fun t : ℂ => Hn n t) (Strip n σ) := by
  have hnn : (0 : ℝ) ≤ (n : ℝ) := Nat.cast_nonneg n
  have hsn : (0 : ℝ) ≤ (9 - σ) * (n : ℝ) := mul_nonneg (by linarith) hnn
  have hnum : ∀ c : ℕ, 9 * n + 1 ≤ c →
      DifferentiableOn ℂ (fun t : ℂ => Complex.Gamma (t + (c : ℂ))) (Strip n σ) := by
    intro c hc
    refine (L7Mid.differentiableOn_Gamma_shift (c : ℂ)).mono ?_
    intro t ht
    have h1 : -σ * (n : ℝ) - 1 / 2 ≤ t.re := ht.1
    have hcge : (9 : ℝ) * (n : ℝ) + 1 ≤ (c : ℝ) := by exact_mod_cast hc
    show (0 : ℝ) < (t + (c : ℂ)).re
    rw [Complex.add_re, Complex.natCast_re]
    linarith
  have href : ∀ c : ℕ, c ≤ 4 * n + 1 →
      DifferentiableOn ℂ (fun t : ℂ => Complex.Gamma (1 - (t + (c : ℂ)))) (Strip n σ) := by
    intro c hc
    refine (differentiableOn_Gamma_reflect (c : ℂ)).mono ?_
    intro t ht
    have h2 : t.re ≤ -4 * (n : ℝ) - 1 / 2 := ht.2
    have hcle : (c : ℝ) ≤ 4 * (n : ℝ) + 1 := by exact_mod_cast hc
    show (0 : ℝ) < (1 - (t + (c : ℂ))).re
    rw [Complex.sub_re, Complex.add_re, Complex.one_re, Complex.natCast_re]
    linarith
  have hconst : DifferentiableOn ℂ
      (fun _ : ℂ => -((Pi_n n : ℂ) / (Real.pi : ℂ))) (Strip n σ) := differentiableOn_const _
  have hsin : DifferentiableOn ℂ
      (fun t : ℂ => Complex.sin ((Real.pi : ℂ) * t)) (Strip n σ) :=
    ((differentiable_id.const_mul ((Real.pi : ℂ))).csin).differentiableOn
  have hinv : DifferentiableOn ℂ
      (fun t : ℂ => (Complex.Gamma (t + (b₄ n : ℂ)))⁻¹) (Strip n σ) :=
    (L7Mid.differentiable_inv_Gamma_shift ((b₄ n : ℕ) : ℂ)).differentiableOn
  have hg1 := hnum (a₁ n) (by simp only [a₁]; omega)
  have hg2 := hnum (a₂ n) (by simp only [a₂]; omega)
  have hg3 := hnum (a₃ n) (by simp only [a₃]; omega)
  have hg4 := hnum (a₄ n) (by simp only [a₄]; omega)
  have hr1 := href (b₁ n) (by simp only [b₁]; omega)
  have hr2 := href (b₂ n) (by simp only [b₂]; omega)
  have hr3 := href (b₃ n) (by simp only [b₃]; omega)
  simp only [Hn]
  exact (((hconst.mul hsin).mul (((hg1.mul hg2).mul hg3).mul hg4)).mul
    ((hr1.mul hr2).mul hr3)).mul hinv

/-- **EDGE (`LEAN.md` §5), `n = 0`.**  `blockCount_le_sqrt` was a live falsehood at `n = 0` in a
green file in this same program, so the question is asked here rather than assumed away: at
`n = 0` the strip is the single line `Re t = −1/2`, every shift collapses to `a_j = b_j = 1`
(and `b₄ = 2`), and analyticity still holds.  So `differentiableOn_Hn` needs no `1 ≤ n` — and
the fact is recorded as a theorem, not as a comment. -/
theorem differentiableOn_Hn_at_zero {σ : ℝ} (hσ : σ ≤ 9) :
    DifferentiableOn ℂ (fun t : ℂ => Hn 0 t) (Strip 0 σ) := differentiableOn_Hn 0 hσ

/-- **EDGE (`LEAN.md` §5), `s = 0`, and pin P4 in one statement.**  The design names `s = 0` as
the one point of the contour where `sin(π t)` can vanish, i.e. where the kernel form
`(π / sin π t)²` does not exist at all.  In the reflected form nothing is divided by `sin`, so
`Hn` is not merely defined there — it is ZERO, because `sin(π t)` is a NUMERATOR factor.  This
is the containment the design records as P4, stated so that a future re-definition in kernel
form would red this line. -/
theorem Hn_defined_at_integer (n : ℕ) (m : ℤ) : Hn n (m : ℂ) = 0 := by
  have hr : Real.sin (Real.pi * (m : ℝ)) = 0 := Real.sin_eq_zero_iff.mpr ⟨m, by ring⟩
  have hc : Complex.sin ((Real.pi : ℂ) * (m : ℂ)) = 0 := by
    have hcast : (Real.pi : ℂ) * (m : ℂ) = ((Real.pi * (m : ℝ) : ℝ) : ℂ) := by push_cast; ring
    rw [hcast, ← Complex.ofReal_sin, hr, Complex.ofReal_zero]
  simp only [Hn, hc]
  ring

/-- **EDGE, the arithmetic half.**  The contour never reaches the point above: its real part is
a half-integer, so `t ∉ ℤ` and `Hn_eq_kernel_form`'s hypothesis holds along the WHOLE line,
`s = 0` included.  Stated for the route-A contour `Re t = −4n − 1/2`, where the fact is exact
rather than a parity argument about `σ̃`'s denominator. -/
theorem contourA_re_not_int (n : ℕ) (k : ℤ) : -4 * (n : ℝ) - 1 / 2 ≠ (k : ℝ) := by
  intro h
  have h2 : ((-8 * (n : ℤ) - 1 : ℤ) : ℝ) = ((2 * k : ℤ) : ℝ) := by push_cast; linarith
  have h3 : (-8 * (n : ℤ) - 1 : ℤ) = 2 * k := by exact_mod_cast h2
  omega

/-! ## §M3. `log Π(n)` from Mathlib's `Stirling` — Robbins is not cited -/

/-- `κ_Π = 11 log 11 − 13 log 13 − 9 log 9 − 5 log 5` (`zeta2-l7-proof.md` §3). -/
noncomputable def kappaPi : ℝ :=
  11 * Real.log 11 - 13 * Real.log 13 - 9 * Real.log 9 - 5 * Real.log 5

/-- `1 < log 2π`, from `Real.pi_gt_three` and `Real.exp_one_lt_d9`.  Load-bearing twice below,
in opposite directions: it is what makes M3's constant NEGATIVE (so `log_Pi_le_const_free` can
drop it outright), and it is what makes M3 FALSE at `n = 0`. -/
theorem one_lt_log_two_pi : (1 : ℝ) < Real.log (2 * Real.pi) := by
  have hpi : (3 : ℝ) < Real.pi := Real.pi_gt_three
  have he : Real.exp 1 < 2.7182818286 := Real.exp_one_lt_d9
  exact (Real.lt_log_iff_exp_lt (by linarith)).mpr (by linarith)

/-- **M3.**  `log Π(n) ≤ n(κ_Π − 16 log n + 16) + 1 − log 2π`, for every `n ≥ 1`.

`zeta2-l7-proof.md` Lemma 2 cites Robbins 1955 for `1/(12m+1) < ε_m < 1/(12m)` and Theorem 5
uses it four times, reaching `+ 1/132`.  None of that precision is needed: probe P6
(`L7Mid.log_factorial_two_sided`, straight from Mathlib's `Stirling`) has an ABSOLUTE constant
`1` on the upper side and `0` on the lower, and the three denominators contribute
`−(3/2)·log 2π` against the numerator's `+(1/2)·log 2π`.  The result is `1 − log 2π ≈ −0.838`,
which is SMALLER than the write-up's `+1/132`, so the crude bound is not merely adequate — it
is better.  Two further negative terms are dropped for simplicity: `−log n` and
`(1/2)·log(11/585) ≈ −1.985`.

The `n log n` bookkeeping is the exact `Σα − Σβ = 16` cancellation of probe P8: the coefficient
of `log n` here is `11 − 13 − 9 − 5 = −16`, matching `L7Mid.cancellation`'s `−16` term. -/
theorem log_Pi_le {n : ℕ} (hn : 1 ≤ n) :
    Real.log (Pi_n n)
      ≤ (n : ℝ) * (kappaPi - 16 * Real.log n + 16) + 1 - Real.log (2 * Real.pi) := by
  have hn0 : ((n : ℝ)) ≠ 0 := by
    have : (0 : ℝ) < (n : ℝ) := by exact_mod_cast hn
    linarith
  have hLn : (0 : ℝ) ≤ Real.log n := Real.log_nonneg (by exact_mod_cast hn)
  have f11 : (0 : ℝ) < (Nat.factorial (11 * n) : ℝ) := by exact_mod_cast Nat.factorial_pos _
  have f13 : (0 : ℝ) < (Nat.factorial (13 * n) : ℝ) := by exact_mod_cast Nat.factorial_pos _
  have f9 : (0 : ℝ) < (Nat.factorial (9 * n) : ℝ) := by exact_mod_cast Nat.factorial_pos _
  have f5 : (0 : ℝ) < (Nat.factorial (5 * n) : ℝ) := by exact_mod_cast Nat.factorial_pos _
  have hlogPi : Real.log (Pi_n n)
      = Real.log (Nat.factorial (11 * n)) - Real.log (Nat.factorial (13 * n))
        - Real.log (Nat.factorial (9 * n)) - Real.log (Nat.factorial (5 * n)) := by
    rw [Pi_n, Real.log_div (ne_of_gt f11) (by positivity),
      Real.log_mul (by positivity) (ne_of_gt f5), Real.log_mul (ne_of_gt f13) (ne_of_gt f9)]
    ring
  have c11 : ((11 * n : ℕ) : ℝ) = 11 * (n : ℝ) := by push_cast; ring
  have c13 : ((13 * n : ℕ) : ℝ) = 13 * (n : ℝ) := by push_cast; ring
  have c9 : ((9 * n : ℕ) : ℝ) = 9 * (n : ℝ) := by push_cast; ring
  have c5 : ((5 * n : ℕ) : ℝ) = 5 * (n : ℝ) := by push_cast; ring
  have h11 := (L7Mid.log_factorial_two_sided (m := 11 * n) (by omega)).2
  have h13 := (L7Mid.log_factorial_two_sided (m := 13 * n) (by omega)).1
  have h9 := (L7Mid.log_factorial_two_sided (m := 9 * n) (by omega)).1
  have h5 := (L7Mid.log_factorial_two_sided (m := 5 * n) (by omega)).1
  rw [c11, Real.log_mul (by norm_num : (11 : ℝ) ≠ 0) hn0] at h11
  rw [c13, Real.log_mul (by norm_num : (13 : ℝ) ≠ 0) hn0] at h13
  rw [c9, Real.log_mul (by norm_num : (9 : ℝ) ≠ 0) hn0] at h9
  rw [c5, Real.log_mul (by norm_num : (5 : ℝ) ≠ 0) hn0] at h5
  have hhalf : Real.log 11 - Real.log 13 - Real.log 9 - Real.log 5 ≤ 0 := by
    have a1 : Real.log 11 ≤ Real.log 13 := Real.log_le_log (by norm_num) (by norm_num)
    have a2 : (0 : ℝ) ≤ Real.log 9 := Real.log_nonneg (by norm_num)
    have a3 : (0 : ℝ) ≤ Real.log 5 := Real.log_nonneg (by norm_num)
    linarith
  rw [hlogPi, kappaPi]
  linarith [h11, h13, h9, h5, hLn, hhalf]

/-- **M3, the form M4 actually wants: a CONSTANT-FREE `Π` bound.**  `1 − log 2π ≈ −0.838 < 0`
by `one_lt_log_two_pi`, so the explicit constant of `log_Pi_le` can be dropped outright: the
eight-`Γ` assembly pays NOTHING for `Π(n)`, where `zeta2-l7-proof.md` Theorem 5's constant
residue pays `+1/132`.  One fewer term in `C_B`'s bookkeeping, and one fewer place for it to be
mis-added. -/
theorem log_Pi_le_const_free {n : ℕ} (hn : 1 ≤ n) :
    Real.log (Pi_n n) ≤ (n : ℝ) * (kappaPi - 16 * Real.log n + 16) := by
  have h := log_Pi_le hn
  linarith [one_lt_log_two_pi]

/-- **EDGE (`LEAN.md` §5), `n = 0` — and this one is a REFUTATION, not a check that passes.**
`Π(0) = 1`, so `log Π(0) = 0`, while `log_Pi_le`'s right-hand side at `n = 0` is
`1 − log 2π ≈ −0.838 < 0`.  So the bound is FALSE at `n = 0`: `log_Pi_le`'s `1 ≤ n` is
load-bearing, and a restatement that dropped it would be a live falsehood in a green file.
Proved rather than asserted, because that is the only version that stays true under a
refactor. -/
theorem log_Pi_le_fails_at_zero :
    ((0 : ℕ) : ℝ) * (kappaPi - 16 * Real.log ((0 : ℕ) : ℝ) + 16) + 1 - Real.log (2 * Real.pi)
      < Real.log (Pi_n 0) := by
  have h0 : Pi_n 0 = 1 := by norm_num [Pi_n]
  have hz : ((0 : ℕ) : ℝ) * (kappaPi - 16 * Real.log ((0 : ℕ) : ℝ) + 16) = 0 := by simp
  rw [h0, Real.log_one, hz]
  linarith [one_lt_log_two_pi]

