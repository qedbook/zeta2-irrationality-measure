section From_M0_L7MidProbe

namespace L7Mid

open Complex Real

/-! ## §1. The sine collapse -/

/-- `‖sin z‖ ≤ cosh (Im z)`, straight from the exponential definition — no `sin²x + sinh²y`
identity needed.  This is all that survives of `zeta2-l7-proof.md` Lemma 3.1. -/
theorem norm_sin_le_cosh (z : ℂ) : ‖Complex.sin z‖ ≤ Real.cosh z.im := by
  rw [Complex.sin]
  have h1 : ‖Complex.exp (-z * Complex.I)‖ = Real.exp z.im := by
    rw [Complex.norm_exp]
    congr 1
    simp [Complex.neg_re, Complex.mul_re]
  have h2 : ‖Complex.exp (z * Complex.I)‖ = Real.exp (-z.im) := by
    rw [Complex.norm_exp]
    congr 1
    simp [Complex.mul_re]
  calc ‖(Complex.exp (-z * Complex.I) - Complex.exp (z * Complex.I)) * Complex.I / 2‖
      = ‖Complex.exp (-z * Complex.I) - Complex.exp (z * Complex.I)‖ / 2 := by
        rw [norm_div, norm_mul, Complex.norm_I, mul_one]
        norm_num
    _ ≤ (‖Complex.exp (-z * Complex.I)‖ + ‖Complex.exp (z * Complex.I)‖) / 2 := by
        have := norm_sub_le (Complex.exp (-z * Complex.I)) (Complex.exp (z * Complex.I))
        linarith
    _ = Real.cosh z.im := by rw [h1, h2, Real.cosh_eq]

/-- `sin(π(t + m)) = (−1)^m sin(π t)` for a NATURAL `m` — the exact identity that makes the
three reflected sines cancel the kernel's two.  The write-up's Lemma 3.1 bound
`|sin π(t+b_j)| ≤ cosh(πs)` throws this equality away, which is what forces Lemma 3.2. -/
theorem sin_pi_mul_add_nat (t : ℂ) : ∀ m : ℕ,
    Complex.sin ((Real.pi : ℂ) * (t + m)) = (-1) ^ m * Complex.sin ((Real.pi : ℂ) * t)
  | 0 => by simp
  | (m + 1) => by
      have hrw : (Real.pi : ℂ) * (t + (m + 1 : ℕ)) = (Real.pi : ℂ) * (t + m) + Real.pi := by
        push_cast; ring
      rw [hrw, Complex.sin_add_pi, sin_pi_mul_add_nat t m]
      ring

/-- Euler reflection, rearranged as a formula for `(Γ s)⁻¹`.  This is the identity that turns a
`Γ` in the DENOMINATOR (where `H_n`'s three left `Γ`'s sit, with negative real part on the
contour) into a `Γ` in the numerator with POSITIVE real part, at the cost of one `sin`. -/
theorem inv_Gamma_reflect {s : ℂ} (hs : Complex.sin ((Real.pi : ℂ) * s) ≠ 0) :
    (Complex.Gamma s)⁻¹ = Complex.Gamma (1 - s) * Complex.sin ((Real.pi : ℂ) * s) / (Real.pi : ℂ) := by
  have hpi : ((Real.pi : ℂ)) ≠ 0 := by
    exact_mod_cast Real.pi_ne_zero
  have h := Complex.Gamma_mul_Gamma_one_sub s
  have hprod : Complex.Gamma s * Complex.Gamma (1 - s) * Complex.sin ((Real.pi : ℂ) * s)
      = (Real.pi : ℂ) := by
    rw [h]; field_simp
  have hG : Complex.Gamma s ≠ 0 := by
    intro h0
    rw [h0] at hprod
    simp at hprod
    exact hpi hprod.symm
  rw [eq_div_iff hpi, inv_mul_eq_div, div_eq_iff hG]
  linear_combination -hprod

/-- **THE COLLAPSE, stated exactly as `H_n` uses it.**  Three reflected denominator `Γ`'s against
the kernel `(π / sin πt)²` leave `sin(π t)` to the FIRST power, in the NUMERATOR, with an
absolute sign — so the whole of `zeta2-l7-proof.md` Lemma 3.2 (odd-denominator separation) and
Lemma 3.3, and with them the `log(1 + q̃²)` term of `C_B` and the requirement that `q̃` be odd,
are unnecessary for the BOUND.  What survives of `q̃` odd is only `sin(π t) ≠ 0`, i.e. that the
contour misses `ℤ` at all — no quantitative separation. -/
theorem kernel_collapse (t : ℂ) (b₁ b₂ b₃ : ℕ)
    (ht : Complex.sin ((Real.pi : ℂ) * t) ≠ 0) :
    (Complex.Gamma (t + b₁))⁻¹ * (Complex.Gamma (t + b₂))⁻¹ * (Complex.Gamma (t + b₃))⁻¹
        * ((Real.pi : ℂ) / Complex.sin ((Real.pi : ℂ) * t)) ^ 2
      = (-1) ^ (b₁ + b₂ + b₃)
        * (Complex.Gamma (1 - (t + b₁)) * Complex.Gamma (1 - (t + b₂)) * Complex.Gamma (1 - (t + b₃)))
        * Complex.sin ((Real.pi : ℂ) * t) / (Real.pi : ℂ) := by
  have hpi : ((Real.pi : ℂ)) ≠ 0 := by exact_mod_cast Real.pi_ne_zero
  have hs : ∀ m : ℕ, Complex.sin ((Real.pi : ℂ) * (t + m)) ≠ 0 := by
    intro m
    rw [sin_pi_mul_add_nat t m]
    exact mul_ne_zero (pow_ne_zero _ (by norm_num)) ht
  rw [inv_Gamma_reflect (hs b₁), inv_Gamma_reflect (hs b₂), inv_Gamma_reflect (hs b₃),
    sin_pi_mul_add_nat t b₁, sin_pi_mul_add_nat t b₂, sin_pi_mul_add_nat t b₃]
  field_simp
  ring

/-! ## §2. Manifest analyticity of the reflected form -/

/-- Every `Γ`-factor of the reflected `H_n` is differentiable where its argument has positive
real part; there is no removable singularity to remove. -/
theorem differentiableOn_Gamma_shift (a : ℂ) :
    DifferentiableOn ℂ (fun t : ℂ => Complex.Gamma (t + a)) {t : ℂ | 0 < (t + a).re} := by
  intro t ht
  refine DifferentiableAt.differentiableWithinAt ?_
  refine (Complex.differentiableAt_Gamma _ ?_).comp t (differentiableAt_id.add_const a)
  intro m hm
  simp only [Set.mem_ofPred_eq] at ht
  rw [hm] at ht
  simp only [Complex.neg_re, Complex.natCast_re] at ht
  linarith [Nat.cast_nonneg (α := ℝ) m]

/-- The one `Γ` that stays in the denominator needs no side condition at all:
`Complex.differentiable_one_div_Gamma` is global. -/
theorem differentiable_inv_Gamma_shift (a : ℂ) :
    Differentiable ℂ (fun t : ℂ => (Complex.Gamma (t + a))⁻¹) :=
  Complex.differentiable_one_div_Gamma.comp (differentiable_id.add_const a)

/-! ## §3. Robbins routed around — two-sided Stirling with ABSOLUTE constants -/

/-- **The two-sided factorial bound `zeta2-l7-proof.md` Lemma 2 cites Robbins for.**  The
sharp `1/(12m)` remainder is decoration here: every constant in Theorem 5 is absorbed into
`C_B`, a prefactor the chain's interface never sees.  Both sides are already in Mathlib
(`Stirling.le_log_factorial_stirling` and `Stirling.stirlingSeq'_antitone`), so Lemma 2 needs
no external citation and no new development. -/
theorem log_factorial_two_sided {m : ℕ} (hm : 1 ≤ m) :
    ((m : ℝ) + 1 / 2) * Real.log m - m + Real.log (2 * Real.pi) / 2 ≤ Real.log (Nat.factorial m)
      ∧ Real.log (Nat.factorial m)
          ≤ ((m : ℝ) + 1 / 2) * Real.log m - m + Real.log (2 * Real.pi) / 2 + 1 := by
  have hm0 : m ≠ 0 := by omega
  have hmpos : (0 : ℝ) < (m : ℝ) := by exact_mod_cast hm
  constructor
  · have hre : ((m : ℝ) + 1 / 2) * Real.log m - m + Real.log (2 * Real.pi) / 2
        = (m : ℝ) * Real.log m - m + Real.log m / 2 + Real.log (2 * Real.pi) / 2 := by ring
    rw [hre]
    exact Stirling.le_log_factorial_stirling hm0
  · -- upper: `stirlingSeq m ≤ stirlingSeq 1 = e / √2`, so `log stirlingSeq m ≤ 1 − ½ log 2`
    obtain ⟨k, rfl⟩ : ∃ k, m = k + 1 := ⟨m - 1, by omega⟩
    have hanti : Stirling.stirlingSeq (k + 1) ≤ Stirling.stirlingSeq (0 + 1) :=
      Stirling.stirlingSeq'_antitone (Nat.zero_le k)
    have h1 : Stirling.stirlingSeq (0 + 1) = Real.exp 1 / Real.sqrt 2 := by
      simp [Stirling.stirlingSeq_one]
    have hpos : (0 : ℝ) < Stirling.stirlingSeq (k + 1) := Stirling.stirlingSeq'_pos k
    have hlog : Real.log (Stirling.stirlingSeq (k + 1)) ≤ 1 - Real.log 2 / 2 := by
      have hle : Stirling.stirlingSeq (k + 1) ≤ Real.exp 1 / Real.sqrt 2 := by
        rw [← h1]; exact hanti
      have h2 : Real.log (Real.exp 1 / Real.sqrt 2) = 1 - Real.log 2 / 2 := by
        rw [Real.log_div (Real.exp_ne_zero 1) (by positivity), Real.log_exp,
          Real.log_sqrt (by norm_num)]
      calc Real.log (Stirling.stirlingSeq (k + 1)) ≤ Real.log (Real.exp 1 / Real.sqrt 2) :=
            Real.log_le_log hpos hle
        _ = 1 - Real.log 2 / 2 := h2
    have hform := Stirling.log_stirlingSeq_formula (k + 1)
    have hcast : ((k : ℝ) + 1) = ((k + 1 : ℕ) : ℝ) := by push_cast; ring
    have hmp : (0 : ℝ) < ((k + 1 : ℕ) : ℝ) := by positivity
    have hsplit : Real.log (2 * ((k + 1 : ℕ) : ℝ))
        = Real.log 2 + Real.log ((k + 1 : ℕ) : ℝ) := Real.log_mul (by norm_num) (ne_of_gt hmp)
    have hdiv : Real.log (((k + 1 : ℕ) : ℝ) / Real.exp 1)
        = Real.log ((k + 1 : ℕ) : ℝ) - 1 := by
      rw [Real.log_div (ne_of_gt hmp) (Real.exp_ne_zero 1), Real.log_exp]
    rw [hsplit, hdiv] at hform
    have h2pi : (0 : ℝ) < Real.log (2 * Real.pi) := by
      have : (1 : ℝ) < 2 * Real.pi := by nlinarith [Real.pi_gt_three]
      exact Real.log_pos this
    have hF : Real.log (Nat.factorial (k + 1))
        = Real.log (Stirling.stirlingSeq (k + 1))
          + 1 / 2 * (Real.log 2 + Real.log ((k + 1 : ℕ) : ℝ))
          + ((k + 1 : ℕ) : ℝ) * (Real.log ((k + 1 : ℕ) : ℝ) - 1) := by linarith [hform]
    have hexp : (((k + 1 : ℕ) : ℝ) + 1 / 2) * Real.log ((k + 1 : ℕ) : ℝ) - ((k + 1 : ℕ) : ℝ)
        = 1 / 2 * Real.log ((k + 1 : ℕ) : ℝ)
          + ((k + 1 : ℕ) : ℝ) * (Real.log ((k + 1 : ℕ) : ℝ) - 1) := by ring
    rw [hF, hexp]
    linarith [hlog, h2pi]

/-! ## §4. Lemma 4(2) reduced to the offset-1/2 lower bound -/

/-- **`zeta2-l7-proof.md` Lemma 4(2) does not need its own expansion, and does not need `q ≥ 20`.**
`Γ(z + 1) = z Γ(z)` moves the offset-3/2 `Γ` to offset 1/2, and the extra factor `‖n u + 1/2‖`
is `≥ n q + 1/2 ≥ 1`, i.e. it only HELPS a lower bound.  So the eighth `Γ` of Theorem 5 is
discharged by the mirror of `lemma4_upper` (C1's bound is two-sided already), and the
0.9956 % margin C6/X-L7 flagged at `D = 26 − σ̃ = 20.199` against `q ≥ 20` DISSOLVES. -/
theorem norm_Gamma_offset_three_halves {n : ℕ} (hn : 1 ≤ n) {q w : ℝ} (hq : 0 < q) :
    ‖Complex.Gamma ((n : ℂ) * ((q : ℂ) + (w : ℂ) * Complex.I) + 3 / 2)‖
      ≥ ((n : ℝ) * q + 1 / 2)
        * ‖Complex.Gamma ((n : ℂ) * ((q : ℂ) + (w : ℂ) * Complex.I) + 1 / 2)‖ := by
  set u : ℂ := (q : ℂ) + (w : ℂ) * Complex.I with hu
  set z : ℂ := (n : ℂ) * u + 1 / 2 with hz
  have hnpos : (0 : ℝ) < (n : ℝ) := by exact_mod_cast hn
  have hzre : z.re = (n : ℝ) * q + 1 / 2 := by
    rw [hz, Complex.add_re, Complex.mul_re]
    simp [hu]
  have hzpos : (0 : ℝ) < z.re := by
    have : (0 : ℝ) < (n : ℝ) * q := mul_pos hnpos hq
    rw [hzre]; linarith
  have hzne : z ≠ 0 := by
    intro h; rw [h] at hzpos; simp at hzpos
  have hshift : (n : ℂ) * u + 3 / 2 = z + 1 := by rw [hz]; ring
  rw [hshift, Complex.Gamma_add_one z hzne, norm_mul]
  have hnorm : z.re ≤ ‖z‖ := le_trans (le_abs_self _) (Complex.abs_re_le_norm z)
  rw [hzre] at hnorm
  exact mul_le_mul_of_nonneg_right hnorm (norm_nonneg _)

/-! ## §5. The `n log n` and `n` cancellations — exact rational identities, not asymptotics -/

/-- The two cancellations of `zeta2-l7-proof.md` Theorem 5, for EVERY `σ`: the `n log n`
coefficients and the `n`-linear `−q` terms both vanish identically, because
`Σα − Σβ = 48 − 32 = 16` with `α = (13,11,9,15)`, `β = (0,2,4,26)`. -/
theorem cancellation (σ : ℝ) :
    ((13 - σ) + (11 - σ) + (9 - σ) + (15 - σ)) + ((σ - 0) + (σ - 2) + (σ - 4))
      - (26 - σ) - 16 = 0 := by ring

