namespace Zeta2SupScheme

open Finset Real Set

/-! ## §0. Generic concavity toolkit (all of it already in Mathlib; assembled here) -/

/-- A globally twice-differentiable real function with nonpositive second derivative is
concave on `univ`. -/
theorem concaveOn_univ_of_hasDerivAt2_nonpos {f f' f'' : ℝ → ℝ}
    (hf : ∀ x, HasDerivAt f (f' x) x) (hf' : ∀ x, HasDerivAt f' (f'' x) x)
    (h : ∀ x, f'' x ≤ 0) : ConcaveOn ℝ (Set.univ : Set ℝ) f := by
  refine concaveOn_of_hasDerivWithinAt2_nonpos convex_univ (fun x _ =>
    (hf x).continuousAt.continuousWithinAt) (fun x _ => (hf x).hasDerivWithinAt)
    (fun x _ => (hf' x).hasDerivWithinAt) (fun x _ => h x)

/-- **The tangent-line bound for a concave function**, on an arbitrary convex set.
This is the single fact the whole sup scheme runs on. -/
theorem tangent_le_on {S : Set ℝ} {f f' : ℝ → ℝ} (hconc : ConcaveOn ℝ S f)
    (hf : ∀ x, HasDerivAt f (f' x) x) {a b : ℝ} (ha : a ∈ S) (hb : b ∈ S) :
    f b ≤ f a + f' a * (b - a) := by
  rcases lt_trichotomy a b with h | h | h
  · have hs := hconc.slope_le_of_hasDerivAt ha hb h (hf a)
    rw [slope_def_field, div_le_iff₀ (by linarith)] at hs
    linarith
  · subst h; simp
  · have hs := hconc.le_slope_of_hasDerivAt hb ha h (hf a)
    rw [slope_def_field, le_div_iff₀ (by linarith)] at hs
    nlinarith [hs]

theorem tangent_le {f f' : ℝ → ℝ} (hconc : ConcaveOn ℝ (Set.univ : Set ℝ) f)
    (hf : ∀ x, HasDerivAt f (f' x) x) (a b : ℝ) :
    f b ≤ f a + f' a * (b - a) :=
  tangent_le_on hconc hf (Set.mem_univ a) (Set.mem_univ b)

/-! ## §1. L7 Lemma 8 — the certified supremum scheme, abstractly

`sup_le_of_bracket` is the LINEAR-cap form (bracket radius × derivative enclosure);
`sup_le_of_bracket_quadratic` is the doc's Lemma 8 verbatim (quadratic cap `g'(w*)²/(2m)`).
Both conclude a bound valid on ALL of `ℝ`, hence a fortiori on `[0, ∞)`.
-/

/-- **L7 Lemma 8 (linear-cap form).**  `w*` is bracketed by a sign change of `f'` at
`w* ∓ r`; `|f'(w*)| ≤ ε`; `f(w*) ≤ G`.  Then `f ≤ G + ε·r` everywhere. -/
theorem sup_le_of_bracket {f f' : ℝ → ℝ}
    (hconc : ConcaveOn ℝ (Set.univ : Set ℝ) f) (hf : ∀ x, HasDerivAt f (f' x) x)
    {ws r ε G : ℝ} (hr : 0 ≤ r)
    (hlo : 0 ≤ f' (ws - r)) (hhi : f' (ws + r) ≤ 0)
    (hε : |f' ws| ≤ ε) (hG : f ws ≤ G) :
    ∀ w : ℝ, f w ≤ G + ε * r := by
  have tang := tangent_le hconc hf
  -- the cap at any point of the bracket
  have cap : ∀ t : ℝ, |t - ws| ≤ r → f t ≤ G + ε * r := by
    intro t ht
    have h1 : f t ≤ f ws + f' ws * (t - ws) := tang ws t
    have h2 : f' ws * (t - ws) ≤ |f' ws| * |t - ws| := by
      calc f' ws * (t - ws) ≤ |f' ws * (t - ws)| := le_abs_self _
        _ = |f' ws| * |t - ws| := abs_mul _ _
    have h3 : |f' ws| * |t - ws| ≤ ε * r :=
      mul_le_mul hε ht (abs_nonneg _) (le_trans (abs_nonneg _) hε)
    linarith
  intro w
  rcases le_or_gt w (ws - r) with hw | hw
  · -- left of the bracket: f increases up to `ws - r`
    have h1 : f w ≤ f (ws - r) + f' (ws - r) * (w - (ws - r)) := tang (ws - r) w
    have h2 : f' (ws - r) * (w - (ws - r)) ≤ 0 :=
      mul_nonpos_of_nonneg_of_nonpos hlo (by linarith)
    have h3 : f (ws - r) ≤ G + ε * r := cap _ (by rw [show ws - r - ws = -r by ring, abs_neg,
      abs_of_nonneg hr])
    linarith
  rcases le_or_gt w (ws + r) with hw' | hw'
  · exact cap w (abs_le.mpr ⟨by linarith, by linarith⟩)
  · -- right of the bracket: f decreases after `ws + r`
    have h1 : f w ≤ f (ws + r) + f' (ws + r) * (w - (ws + r)) := tang (ws + r) w
    have h2 : f' (ws + r) * (w - (ws + r)) ≤ 0 :=
      mul_nonpos_of_nonpos_of_nonneg hhi (by linarith)
    have h3 : f (ws + r) ≤ G + ε * r := cap _ (by rw [show ws + r - ws = r by ring,
      abs_of_nonneg hr])
    linarith

/-- **L7 Lemma 8 verbatim (quadratic cap).**  With `f'' ≤ −m < 0` on the bracket,
`sup f ≤ f(w*) + f'(w*)²/(2m)`. -/
theorem sup_le_of_bracket_quadratic {f f' f'' : ℝ → ℝ}
    (hconc : ConcaveOn ℝ (Set.univ : Set ℝ) f)
    (hf : ∀ x, HasDerivAt f (f' x) x) (hf' : ∀ x, HasDerivAt f' (f'' x) x)
    {ws r m G : ℝ} (hr : 0 ≤ r) (hm : 0 < m)
    (hlo : 0 ≤ f' (ws - r)) (hhi : f' (ws + r) ≤ 0)
    (hmm : ∀ x ∈ Set.Icc (ws - r) (ws + r), f'' x ≤ -m)
    (hG : f ws ≤ G) :
    ∀ w : ℝ, f w ≤ G + (f' ws) ^ 2 / (2 * m) := by
  set S : Set ℝ := Set.Icc (ws - r) (ws + r) with hS
  have hwsS : ws ∈ S := ⟨by linarith, by linarith⟩
  -- ψ = f + (m/2)·x², ψ' = f' + m·x, ψ'' = f'' + m
  have hpsi1 : ∀ x : ℝ, HasDerivAt (fun t : ℝ => f t + (m / 2) * t ^ 2) (f' x + m * x) x := by
    intro x
    have h := (hf x).add ((hasDerivAt_pow 2 x).const_mul (m / 2))
    have e : f' x + m / 2 * ((2 : ℕ) * x ^ (2 - 1)) = f' x + m * x := by push_cast; ring
    exact e ▸ h
  have hpsi2 : ∀ x : ℝ, HasDerivAt (fun t : ℝ => f' t + m * t) (f'' x + m) x := by
    intro x
    have h := (hf' x).add ((hasDerivAt_id x).const_mul m)
    have e : f'' x + m * 1 = f'' x + m := by ring
    exact e ▸ h
  -- ψ is concave on the bracket, because ψ'' = f'' + m ≤ 0 there
  have hpsi : ConcaveOn ℝ S (fun x => f x + (m / 2) * x ^ 2) := by
    refine concaveOn_of_hasDerivWithinAt2_nonpos (convex_Icc _ _)
      (fun x _ => (hpsi1 x).continuousAt.continuousWithinAt)
      (f' := fun x => f' x + m * x) (f'' := fun x => f'' x + m)
      (fun x _ => (hpsi1 x).hasDerivWithinAt)
      (fun x _ => (hpsi2 x).hasDerivWithinAt) ?_
    intro x hx
    have hx' : x ∈ S := interior_subset hx
    have := hmm x hx'
    linarith
  -- the strong-concavity tangent bound on the bracket
  have strong : ∀ t ∈ S, f t ≤ f ws + f' ws * (t - ws) - (m / 2) * (t - ws) ^ 2 := by
    intro t ht
    have := tangent_le_on (f := fun x => f x + (m / 2) * x ^ 2)
      (f' := fun x => f' x + m * x) hpsi hpsi1 hwsS ht
    nlinarith [this]
  have cap : ∀ t ∈ S, f t ≤ G + (f' ws) ^ 2 / (2 * m) := by
    intro t ht
    have h1 := strong t ht
    have h2 : f' ws * (t - ws) - (m / 2) * (t - ws) ^ 2 ≤ (f' ws) ^ 2 / (2 * m) := by
      rw [le_div_iff₀ (by linarith)]
      nlinarith [sq_nonneg (m * (t - ws) - f' ws)]
    linarith
  have tang := tangent_le hconc hf
  intro w
  rcases le_or_gt w (ws - r) with hw | hw
  · have h1 : f w ≤ f (ws - r) + f' (ws - r) * (w - (ws - r)) := tang (ws - r) w
    have h2 : f' (ws - r) * (w - (ws - r)) ≤ 0 :=
      mul_nonpos_of_nonneg_of_nonpos hlo (by linarith)
    have h3 := cap (ws - r) ⟨le_refl _, by linarith⟩
    linarith
  rcases le_or_gt w (ws + r) with hw' | hw'
  · exact cap w ⟨by linarith, hw'⟩
  · have h1 : f w ≤ f (ws + r) + f' (ws + r) * (w - (ws + r)) := tang (ws + r) w
    have h2 : f' (ws + r) * (w - (ws + r)) ≤ 0 :=
      mul_nonpos_of_nonpos_of_nonneg hhi (by linarith)
    have h3 := cap (ws + r) ⟨by linarith, le_refl _⟩
    linarith

/-- **The tangent tail** — the second thing §6 consumes: past `a`, a concave `f` sits under
a line of certified negative slope. -/
theorem tail_decay {f f' : ℝ → ℝ} (hconc : ConcaveOn ℝ (Set.univ : Set ℝ) f)
    (hf : ∀ x, HasDerivAt f (f' x) x) {a G c : ℝ}
    (hga : f a ≤ G) (hda : f' a ≤ -c) :
    ∀ w : ℝ, a ≤ w → f w ≤ G - c * (w - a) := by
  intro w hw
  have h1 : f w ≤ f a + f' a * (w - a) := tangent_le hconc hf a w
  nlinarith [h1, hga, hda, sub_nonneg.mpr hw]

/-! ## §2. L7 Lemma 6 — the phase function and its two derivatives -/

/-- `L(q,w) = (q/2)·log(q²+w²) − w·arctan(w/q)`. -/
noncomputable def Lterm (q w : ℝ) : ℝ :=
  (q / 2) * Real.log (q ^ 2 + w ^ 2) - w * Real.arctan (w / q)

/-- **L7 Lemma 6, single term.** `∂L/∂w = −arctan(w/q)`. -/
theorem hasDerivAt_Lterm (q : ℝ) (hq : 0 < q) (w : ℝ) :
    HasDerivAt (fun x : ℝ => Lterm q x) (-Real.arctan (w / q)) w := by
  have hne : q ^ 2 + w ^ 2 ≠ 0 := by positivity
  have hsq : HasDerivAt (fun x : ℝ => q ^ 2 + x ^ 2) (2 * w) w := by
    simpa using ((hasDerivAt_pow 2 w).const_add (q ^ 2))
  have hlog : HasDerivAt (fun x : ℝ => Real.log (q ^ 2 + x ^ 2))
      ((2 * w) / (q ^ 2 + w ^ 2)) w := hsq.log hne
  have hA : HasDerivAt (fun x : ℝ => (q / 2) * Real.log (q ^ 2 + x ^ 2))
      ((q / 2) * ((2 * w) / (q ^ 2 + w ^ 2))) w := hlog.const_mul (q / 2)
  have hdiv : HasDerivAt (fun x : ℝ => x / q) (1 / q) w := by
    simpa using (hasDerivAt_id w).div_const q
  have hat : HasDerivAt (fun x : ℝ => Real.arctan (x / q))
      ((1 / (1 + (w / q) ^ 2)) * (1 / q)) w := by
    simpa [Function.comp_def] using (Real.hasDerivAt_arctan (w / q)).comp w hdiv
  have hB : HasDerivAt (fun x : ℝ => x * Real.arctan (x / q))
      (1 * Real.arctan (w / q) + w * ((1 / (1 + (w / q) ^ 2)) * (1 / q))) w :=
    (hasDerivAt_id w).mul hat
  have hq0 : q ≠ 0 := ne_of_gt hq
  have hshape : (1 : ℝ) + (w / q) ^ 2 = (q ^ 2 + w ^ 2) / q ^ 2 := by field_simp
  have key :
      (q / 2) * ((2 * w) / (q ^ 2 + w ^ 2))
        - (1 * Real.arctan (w / q) + w * ((1 / (1 + (w / q) ^ 2)) * (1 / q)))
      = -Real.arctan (w / q) := by
    rw [hshape]
    have : (0 : ℝ) < q ^ 2 + w ^ 2 := by positivity
    field_simp
    ring
  exact key ▸ hA.sub hB

/-- `∂/∂w arctan(w/q) = q/(q²+w²)` — the second derivative's building block. -/
theorem hasDerivAt_arctanDiv (q : ℝ) (hq : 0 < q) (w : ℝ) :
    HasDerivAt (fun x : ℝ => Real.arctan (x / q)) (q / (q ^ 2 + w ^ 2)) w := by
  have hq0 : q ≠ 0 := ne_of_gt hq
  have hdiv : HasDerivAt (fun x : ℝ => x / q) (1 / q) w := by
    simpa using (hasDerivAt_id w).div_const q
  have hat : HasDerivAt (fun x : ℝ => Real.arctan (x / q))
      ((1 / (1 + (w / q) ^ 2)) * (1 / q)) w := by
    simpa [Function.comp_def] using (Real.hasDerivAt_arctan (w / q)).comp w hdiv
  have hshape : (1 : ℝ) + (w / q) ^ 2 = (q ^ 2 + w ^ 2) / q ^ 2 := by field_simp
  have hpos : (0 : ℝ) < q ^ 2 + w ^ 2 := by positivity
  have key : (1 / (1 + (w / q) ^ 2)) * (1 / q) = q / (q ^ 2 + w ^ 2) := by
    rw [hshape]; field_simp
  exact key ▸ hat

variable {ι : Type*}

/-- The phase `g(w) = c + κπw + Σ_i L(q_i, w) − L(D, w)`.

NOTE ON `|w|`: the true phase of zeta2-l7-proof.md §3 carries `κπ|w|` and is used only on
`w ≥ 0`, where it AGREES with this function.  Working with `w` rather than `|w|` is not a
weakening — it is what makes the smooth extension concave on all of `ℝ` (referee item 6),
and every conclusion below is an upper bound, so it transfers verbatim to `w ≥ 0`. -/
noncomputable def phase (s : Finset ι) (qf : ι → ℝ) (D κ c : ℝ) (w : ℝ) : ℝ :=
  c + κ * Real.pi * w + (∑ i ∈ s, Lterm (qf i) w) - Lterm D w

/-- `g′(w) = κπ − Σ_i arctan(w/q_i) + arctan(w/D)`. -/
noncomputable def phaseD (s : Finset ι) (qf : ι → ℝ) (D κ : ℝ) (w : ℝ) : ℝ :=
  κ * Real.pi - (∑ i ∈ s, Real.arctan (w / qf i)) + Real.arctan (w / D)

/-- `g″(w) = −Σ_i q_i/(q_i²+w²) + D/(D²+w²)`. -/
noncomputable def phaseDD (s : Finset ι) (qf : ι → ℝ) (D : ℝ) (w : ℝ) : ℝ :=
  -(∑ i ∈ s, qf i / (qf i ^ 2 + w ^ 2)) + D / (D ^ 2 + w ^ 2)

/-- **L7 Lemma 6 (assembled, first derivative).** -/
theorem hasDerivAt_phase (s : Finset ι) (qf : ι → ℝ) (D κ c : ℝ)
    (hq : ∀ i ∈ s, 0 < qf i) (hD : 0 < D) (w : ℝ) :
    HasDerivAt (phase s qf D κ c) (phaseD s qf D κ w) w := by
  have hsum : HasDerivAt (fun x : ℝ => ∑ i ∈ s, Lterm (qf i) x)
      (∑ i ∈ s, -Real.arctan (w / qf i)) w :=
    HasDerivAt.fun_sum (fun i hi => hasDerivAt_Lterm (qf i) (hq i hi) w)
  have hlin : HasDerivAt (fun x : ℝ => c + κ * Real.pi * x) (κ * Real.pi) w := by
    simpa using ((hasDerivAt_id w).const_mul (κ * Real.pi)).const_add c
  have h := (hlin.fun_add hsum).fun_sub (hasDerivAt_Lterm D hD w)
  have key : κ * Real.pi + (∑ i ∈ s, -Real.arctan (w / qf i)) - -Real.arctan (w / D)
      = phaseD s qf D κ w := by
    simp only [phaseD, Finset.sum_neg_distrib]
    ring
  exact key ▸ h

/-- **L7 Lemma 6 (assembled, second derivative).** -/
theorem hasDerivAt_phaseD (s : Finset ι) (qf : ι → ℝ) (D κ : ℝ)
    (hq : ∀ i ∈ s, 0 < qf i) (hD : 0 < D) (w : ℝ) :
    HasDerivAt (phaseD s qf D κ) (phaseDD s qf D w) w := by
  have hsum : HasDerivAt (fun x : ℝ => ∑ i ∈ s, Real.arctan (x / qf i))
      (∑ i ∈ s, qf i / (qf i ^ 2 + w ^ 2)) w :=
    HasDerivAt.fun_sum (fun i hi => hasDerivAt_arctanDiv (qf i) (hq i hi) w)
  have h := ((hasDerivAt_const w (κ * Real.pi)).fun_sub hsum).fun_add
    (hasDerivAt_arctanDiv D hD w)
  have key : (0 : ℝ) - (∑ i ∈ s, qf i / (qf i ^ 2 + w ^ 2)) + D / (D ^ 2 + w ^ 2)
      = phaseDD s qf D w := by
    simp only [phaseDD]; ring
  exact key ▸ h

/-! ## §3. L7 Lemma 7 — global concavity from two exact rational inequalities -/

/-- **L7 Lemma 7, in full generality and for EVERY real `w`** (the doc states it on `(0,∞)`;
the proof never uses `w > 0`, only `w² ≥ 0`, so the smooth phase is concave on all of `ℝ`).

`hq`/`hle` bound the family; `h1 : D < Σq` controls the `w → ∞` regime; `h2` controls
`w = 0`.  Both are needed: dropping `h1` makes the claim FALSE for large `w`. -/
theorem concavity_criterion (s : Finset ι) (qf : ι → ℝ) (D qmax : ℝ)
    (hD : 0 < D) (hq : ∀ i ∈ s, 0 < qf i) (hle : ∀ i ∈ s, qf i ≤ qmax)
    (h1 : D < ∑ i ∈ s, qf i)
    (h2 : D * qmax ^ 2 < (∑ i ∈ s, qf i) * D ^ 2)
    (w : ℝ) :
    D / (D ^ 2 + w ^ 2) < ∑ i ∈ s, qf i / (qf i ^ 2 + w ^ 2) := by
  have hqmax : 0 < qmax := by
    rcases s.eq_empty_or_nonempty with rfl | ⟨i, hi⟩
    · simp at h1; nlinarith
    · exact lt_of_lt_of_le (hq i hi) (hle i hi)
  have hbig : (0:ℝ) < qmax ^ 2 + w ^ 2 := by positivity
  have step : ∑ i ∈ s, qf i / (qmax ^ 2 + w ^ 2) ≤ ∑ i ∈ s, qf i / (qf i ^ 2 + w ^ 2) := by
    refine Finset.sum_le_sum ?_
    intro i hi
    have hqi := hq i hi
    have hsmall : (0:ℝ) < qf i ^ 2 + w ^ 2 := by positivity
    have : qf i ^ 2 + w ^ 2 ≤ qmax ^ 2 + w ^ 2 := by
      have := hle i hi
      nlinarith [hqi.le, hqmax.le]
    exact div_le_div_of_nonneg_left hqi.le hsmall this
  rw [← Finset.sum_div] at step
  refine lt_of_lt_of_le ?_ step
  have hDw : (0:ℝ) < D ^ 2 + w ^ 2 := by positivity
  rw [div_lt_div_iff₀ hDw hbig]
  nlinarith [sq_nonneg w, h1, h2]

/-- `g″ < 0` everywhere. -/
theorem phaseDD_neg (s : Finset ι) (qf : ι → ℝ) (D qmax : ℝ)
    (hD : 0 < D) (hq : ∀ i ∈ s, 0 < qf i) (hle : ∀ i ∈ s, qf i ≤ qmax)
    (h1 : D < ∑ i ∈ s, qf i)
    (h2 : D * qmax ^ 2 < (∑ i ∈ s, qf i) * D ^ 2)
    (w : ℝ) : phaseDD s qf D w < 0 := by
  have := concavity_criterion s qf D qmax hD hq hle h1 h2 w
  simp only [phaseDD]
  linarith

/-- **L7 Lemma 7, packaged: the phase is concave.** -/
theorem phase_concaveOn (s : Finset ι) (qf : ι → ℝ) (D qmax κ c : ℝ)
    (hD : 0 < D) (hq : ∀ i ∈ s, 0 < qf i) (hle : ∀ i ∈ s, qf i ≤ qmax)
    (h1 : D < ∑ i ∈ s, qf i)
    (h2 : D * qmax ^ 2 < (∑ i ∈ s, qf i) * D ^ 2) :
    ConcaveOn ℝ (Set.univ : Set ℝ) (phase s qf D κ c) :=
  concaveOn_univ_of_hasDerivAt2_nonpos
    (fun x => hasDerivAt_phase s qf D κ c hq hD x)
    (fun x => hasDerivAt_phaseD s qf D κ hq hD x)
    (fun x => (phaseDD_neg s qf D qmax hD hq hle h1 h2 x).le)

/-! ## §4. The two statements §6 of zeta2-l7-proof.md actually consumes -/

/-- **(i) The certified supremum.**  Hypotheses `hbl`/`hbr`/`hε`/`hG` are exactly what an
interval-arithmetic certificate at the witness `w*` produces. -/
theorem phase_sup_le (s : Finset ι) (qf : ι → ℝ) (D qmax κ c : ℝ)
    (hD : 0 < D) (hq : ∀ i ∈ s, 0 < qf i) (hle : ∀ i ∈ s, qf i ≤ qmax)
    (h1 : D < ∑ i ∈ s, qf i) (h2 : D * qmax ^ 2 < (∑ i ∈ s, qf i) * D ^ 2)
    {ws r ε G : ℝ} (hr : 0 ≤ r)
    (hbl : 0 ≤ phaseD s qf D κ (ws - r)) (hbr : phaseD s qf D κ (ws + r) ≤ 0)
    (hε : |phaseD s qf D κ ws| ≤ ε) (hG : phase s qf D κ c ws ≤ G) :
    ∀ w : ℝ, 0 ≤ w → phase s qf D κ c w ≤ G + ε * r := by
  intro w _
  exact sup_le_of_bracket (phase_concaveOn s qf D qmax κ c hD hq hle h1 h2)
    (fun x => hasDerivAt_phase s qf D κ c hq hD x) hr hbl hbr hε hG w

/-- **(i′) The same with the doc's verbatim quadratic cap `g′(w*)²/(2m)`.** -/
theorem phase_sup_le_quadratic (s : Finset ι) (qf : ι → ℝ) (D qmax κ c : ℝ)
    (hD : 0 < D) (hq : ∀ i ∈ s, 0 < qf i) (hle : ∀ i ∈ s, qf i ≤ qmax)
    (h1 : D < ∑ i ∈ s, qf i) (h2 : D * qmax ^ 2 < (∑ i ∈ s, qf i) * D ^ 2)
    {ws r m G : ℝ} (hr : 0 ≤ r) (hm : 0 < m)
    (hbl : 0 ≤ phaseD s qf D κ (ws - r)) (hbr : phaseD s qf D κ (ws + r) ≤ 0)
    (hmm : ∀ x ∈ Set.Icc (ws - r) (ws + r), phaseDD s qf D x ≤ -m)
    (hG : phase s qf D κ c ws ≤ G) :
    ∀ w : ℝ, 0 ≤ w → phase s qf D κ c w ≤ G + (phaseD s qf D κ ws) ^ 2 / (2 * m) := by
  intro w _
  exact sup_le_of_bracket_quadratic (phase_concaveOn s qf D qmax κ c hD hq hle h1 h2)
    (fun x => hasDerivAt_phase s qf D κ c hq hD x)
    (fun x => hasDerivAt_phaseD s qf D κ hq hD x) hr hm hbl hbr hmm hG w

/-- **(ii) The tangent tail** — `g(w) ≤ G − c₀(w − a)` for `w ≥ a`, from `g(a) ≤ G` and a
certified negative slope `g′(a) ≤ −c₀`.  This is what turns the `[3,∞)` piece of the
`§6` integral into `e^{nG}/(c₀ n)`. -/
theorem phase_tail_decay (s : Finset ι) (qf : ι → ℝ) (D qmax κ c : ℝ)
    (hD : 0 < D) (hq : ∀ i ∈ s, 0 < qf i) (hle : ∀ i ∈ s, qf i ≤ qmax)
    (h1 : D < ∑ i ∈ s, qf i) (h2 : D * qmax ^ 2 < (∑ i ∈ s, qf i) * D ^ 2)
    {a G c₀ : ℝ} (hga : phase s qf D κ c a ≤ G) (hda : phaseD s qf D κ a ≤ -c₀) :
    ∀ w : ℝ, a ≤ w → phase s qf D κ c w ≤ G - c₀ * (w - a) :=
  tail_decay (phase_concaveOn s qf D qmax κ c hD hq hle h1 h2)
    (fun x => hasDerivAt_phase s qf D κ c hq hD x) hga hda

/-! ## §5. Discharging the concavity hypotheses for the two actual parameter sets

Route A (σ = 4): the "+" family is `A = α − 4 = (9,7,5,11)` together with `B = 4 − β`
restricted to `β ∈ {0,2}` (`β = 4` gives `B₃ = 0`, handled by the exact `Γ(1/2+is)`
identity instead), so `q = (9,7,5,11,4,2)`, `D = 22`, `qmax = 11`, `κ = 1/2`.

Route B (σ̃ = 58008700/9999999): `q = (13−σ̃, 11−σ̃, 9−σ̃, 15−σ̃, σ̃, σ̃−2, σ̃−4)`,
`D = 26 − σ̃`, `qmax = 15 − σ̃`, `κ = 1`.  `Σq = 42 − σ̃`.

EDGE CHECKS (LEAN.md §5), all discharged below or in `margins_c6.py`:
* `w = 0`: `concavity_criterion` is proved for every real `w`, `0` included; at `w = 0` it
  reads `1/D < Σ 1/q_i`, which the two hypotheses imply.  No case split, no exclusion.
* smallest admissible `q`: route B's is `σ̃ − 4 = 18008704/9999999 ≈ 1.80087 > 0`.  It is
  positive with room here; it is NOT elsewhere — see the loud note in the design doc.
* the bracket endpoints `w* ∓ r` are both `> 0` (`w* ≈ 2.15`, `r = 10⁻⁹`), so the phase's
  `κπ|w| = κπw` identification holds across the whole bracket.
-/

/-- Route A's "+" family. -/
def qA : Fin 6 → ℝ := ![9, 7, 5, 11, 4, 2]

/-- Route B's "+" family at `σ̃ = 58008700/9999999`. -/
noncomputable def sigT : ℝ := 58008700 / 9999999

noncomputable def qB : Fin 7 → ℝ :=
  ![13 - sigT, 11 - sigT, 9 - sigT, 15 - sigT, sigT, sigT - 2, sigT - 4]

theorem qA_pos : ∀ i ∈ (Finset.univ : Finset (Fin 6)), 0 < qA i := by
  intro i _; fin_cases i <;> norm_num [qA]

theorem qA_le : ∀ i ∈ (Finset.univ : Finset (Fin 6)), qA i ≤ 11 := by
  intro i _; fin_cases i <;> norm_num [qA]

theorem qA_sum : ∑ i ∈ (Finset.univ : Finset (Fin 6)), qA i = 38 := by
  simp [qA, Fin.sum_univ_six]; norm_num

theorem routeA_h1 : (22 : ℝ) < ∑ i ∈ (Finset.univ : Finset (Fin 6)), qA i := by
  rw [qA_sum]; norm_num

theorem routeA_h2 :
    (22 : ℝ) * 11 ^ 2 < (∑ i ∈ (Finset.univ : Finset (Fin 6)), qA i) * 22 ^ 2 := by
  rw [qA_sum]; norm_num

/-- Route A: the phase is concave on all of `ℝ`. -/
theorem routeA_concaveOn (c : ℝ) :
    ConcaveOn ℝ (Set.univ : Set ℝ) (phase Finset.univ qA 22 (1/2) c) :=
  phase_concaveOn _ _ _ 11 _ _ (by norm_num) qA_pos qA_le routeA_h1 routeA_h2

theorem qB_pos : ∀ i ∈ (Finset.univ : Finset (Fin 7)), 0 < qB i := by
  intro i _; fin_cases i <;> norm_num [qB, sigT]

theorem qB_le : ∀ i ∈ (Finset.univ : Finset (Fin 7)), qB i ≤ 15 - sigT := by
  intro i _; fin_cases i <;> norm_num [qB, sigT]

theorem qB_sum : ∑ i ∈ (Finset.univ : Finset (Fin 7)), qB i = 42 - sigT := by
  simp [qB, Fin.sum_univ_seven]; ring

theorem routeB_h1 : (26 : ℝ) - sigT < ∑ i ∈ (Finset.univ : Finset (Fin 7)), qB i := by
  rw [qB_sum]; norm_num [sigT]

theorem routeB_h2 :
    ((26 : ℝ) - sigT) * (15 - sigT) ^ 2
      < (∑ i ∈ (Finset.univ : Finset (Fin 7)), qB i) * (26 - sigT) ^ 2 := by
  rw [qB_sum]; norm_num [sigT]

/-- Route B: the phase is concave on all of `ℝ`. -/
theorem routeB_concaveOn (c : ℝ) :
    ConcaveOn ℝ (Set.univ : Set ℝ) (phase Finset.univ qB (26 - sigT) 1 c) :=
  phase_concaveOn _ _ _ (15 - sigT) _ _ (by norm_num [sigT]) qB_pos qB_le routeB_h1 routeB_h2

/-! ### §5b. EXECUTING THE COMPOSITION (LEAN.md §3)

Proving the pieces "with the others as hypotheses" is not composing.  The two theorems below
