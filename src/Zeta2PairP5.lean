/-- The division identity `R + denPoly 5 · Q = numPoly 5`: the three numerator blocks
and the denominator block unfold to 135 and 56 explicit factors `X + k`, and `ring`
closes it. -/
theorem div_identity : R + candidateM.denPoly 5 * Q = candidateM.numPoly 5 := by
  simp only [Q, R, Member.numPoly, Member.denPoly, candidateM, block, Nat.reduceMul,
    Nat.reduceSub, Nat.reduceAdd, Finset.prod_range_succ, Finset.prod_range_zero, map_natCast,
    map_ofNat, map_neg, map_one]
  push_cast
  ring

theorem R_degree_lt : R.degree < (candidateM.denPoly 5).degree := by
  apply Polynomial.degree_lt_degree
  rw [candidateM.denPoly_natDegree 5]
  have h : R.natDegree ≤ 55 := by rw [R]; compute_degree!
  simp only [candidateM] at h ⊢
  omega

/-- **`Ppol 5` is `Q`** — the first evaluation of `candidateM.Ppol` in the corpus. -/
theorem Ppol_eq : candidateM.Ppol 5 = Q :=
  (Polynomial.div_modByMonic_unique Q R (candidateM.denPoly_monic 5)
    ⟨div_identity, R_degree_lt⟩).1

theorem cell_eq : candidateM.cell 5 = -21 := by decide

/-- `Σ_j Q_j · momI (cell 5) j` — the polynomial half of `pn 5`, the number
`Zeta2DefsCheck.enginePnPoly` only RECORDS.  `sum_momI` replaces the noncomputable `momI`
under the sum by the 80-entry list `momList (-21) 80`, which the kernel
builds ONCE; `simp only [Q, …]` turns each `Q.coeff j` into its literal.  Row PAIR-VAL. -/
theorem pnPoly_eq : candidateM.pnPoly 5 = (-8257631617391440627199034385308443732938432664270926681662357951021976851535688636905719712194108810584403013904955463653329841878211470516295851649241218891901864073693415453229056000000000000000 / 98733594781 : ℚ) := by
  have hd : (candidateM.Ppol 5).natDegree = 79 := by
    rw [candidate_Ppol_natDegree]
  rw [Member.pnPoly, hd, Ppol_eq, cell_eq, Zeta2MomC.sum_momI]
  simp only [Q, coeff_add, coeff_C_mul_X_pow]
  decide +kernel

/-- The harmonic half, computable: `Σ_k ck 5 k · H^{(2)}_{k − 21}` over the window.
`Zeta2HarmC.pnHarm_shared` puts ONE `harmList 2 110` under the sum and indexes it, so the
kernel adds 110 rationals instead of recomputing `harm 2` at each of the 56 window
terms (row PAIR-VAL, third pass — the same lever `Zeta2MomC.sum_momI` is on the moment side). -/
theorem pnHarm_eq : candidateM.pnHarm 5 = (23669833205829970989265398939936409897551569935997480953702934968158632915145197737916510691059718780232846753720067685508660501185529903714301712941674170734896451401044326778667008000000000000000 / 1249792339 : ℚ) := by
  rw [Zeta2HarmC.pnHarm_shared candidateM (by decide) 5]
  decide +kernel

/-- **`pn 5`, evaluated** — the same literal `hatP_engine` below pins from the hat side. -/
theorem pn_eq : candidateM.pn 5 = (-76518354564752357858853200937698853578283252693857782145328874881157931958675979179900540796942607830945094591838850543 / 4848436648964242046442527616000 : ℚ) := by
  rw [Member.pn, pnPoly_eq, pnHarm_eq]
  decide +kernel

/-- Kernel pin on the HAT side: `hatP 5` is the tale-1 engine's `p_5`.  Rendered by
`gen_hat_lean.hatP_pin_lines`, the same function `Zeta2HatCheck.lean` uses for n ≤ 3. -/
theorem hatP_engine : hatP 5 = (-76518354564752357858853200937698853578283252693857782145328874881157931958675979179900540796942607830945094591838850543 / 4848436648964242046442527616000 : ℚ) := by
  rw [Zeta2HarmC.hatP_shared]
  simp only [hatA, Nat.choose_eq_descFactorial_div_factorial]
  decide +kernel

/-- **The row's statement at n = 5**: `hatP 5 = candidateM.pn 5`. -/
theorem hatP_eq_pn : hatP 5 = candidateM.pn 5 := by
  rw [hatP_engine, pn_eq]

