/-! ## The Π data, tied to `Zeta2Pair7Pi`'s affine runs

Each tie is one `decide +kernel` over integer lists of degree ≤ 22: the emitted
literal IS the product of the runs, so nothing downstream has to trust the
generator's expansion. -/

theorem Rn_eq (t : ℚ) : hornerQ Rn t
    = qfacProd t (runFacs 17 (17 * (1))) * qfacProd t (runFacs 5 (5 * (1))) := by
  simp only [← hornerQ_zprod_eq, ← hornerQ_zmul]
  exact hornerQ_eq_of_ztrim_zsub _ _ t (by decide +kernel)

theorem Rd_eq (t : ℚ) : hornerQ Rd t
    = qfacProd t (runFacs 11 (11 * (1))) * qfacProd t (runFacs 11 (11 * (1))) := by
  simp only [← hornerQ_zprod_eq, ← hornerQ_zmul]
  exact hornerQ_eq_of_ztrim_zsub _ _ t (by decide +kernel)

theorem Sn_eq (t : ℚ) : hornerQ Sn t
    = qfacProd t (runFacs 13 (13 * (1))) * qfacProd t (runFacs 9 (9 * (1)))
      * qfacProd t (runFacs 5 (5 * (1))) := by
  simp only [← hornerQ_zprod_eq, ← hornerQ_zmul]
  exact hornerQ_eq_of_ztrim_zsub _ _ t (by decide +kernel)

theorem Sd_eq (t : ℚ) : hornerQ Sd t
