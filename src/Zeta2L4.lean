/-! ## 1. The criterion (spliced verbatim from `Zeta2D4.lean`) -/

/--
**L4's dominance criterion.**  If the low-order coefficients are dominated at one point
`m > 0`,

`Σ_{i<d} |a_i| m^i < |a_d| m^d`,

then the polynomial `Σ_{i≤d} a_i x^i` has NO root at any `x ≥ m`.  One exact check at `m₀`
therefore covers the whole real tail — which is exactly the argument
docs/future/zeta2-chain-close.md §L4 records ("each normalized term strictly decreasing in
real `m > 0`, so one exact check covers the whole tail"), stated once and proved once.

The scaling step needs no division: `x^i·m^d ≤ m^i·x^d` for `i ≤ d` because `x ≥ m > 0`.
-/
theorem no_root_from_dominance {d : ℕ} (a : ℕ → ℚ) (m : ℚ) (hm : 0 < m)
    (hdom : ∑ i ∈ range d, |a i| * m ^ i < |a d| * m ^ d) (x : ℚ) (hx : m ≤ x) :
    ∑ i ∈ range (d + 1), a i * x ^ i ≠ 0 := by
  have hx0 : 0 < x := lt_of_lt_of_le hm hx
  have hmd : (0 : ℚ) < m ^ d := pow_pos hm d
  have hxd : (0 : ℚ) < x ^ d := pow_pos hx0 d
  have key : ∀ i ∈ range d, |a i| * x ^ i * m ^ d ≤ |a i| * m ^ i * x ^ d := by
    intro i hi
    obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le (le_of_lt (Finset.mem_range.mp hi))
    have hpk : m ^ k ≤ x ^ k := pow_le_pow_left₀ hm.le hx k
    have hpos : (0 : ℚ) ≤ |a i| * (x ^ i * m ^ i) := by positivity
    calc |a i| * x ^ i * m ^ (i + k) = |a i| * (x ^ i * m ^ i) * m ^ k := by ring
      _ ≤ |a i| * (x ^ i * m ^ i) * x ^ k := mul_le_mul_of_nonneg_left hpk hpos
      _ = |a i| * m ^ i * x ^ (i + k) := by ring
  have hscale : (∑ i ∈ range d, |a i| * x ^ i) * m ^ d
      ≤ (∑ i ∈ range d, |a i| * m ^ i) * x ^ d := by
    rw [Finset.sum_mul, Finset.sum_mul]
    exact Finset.sum_le_sum key
  have hlt : (∑ i ∈ range d, |a i| * x ^ i) * m ^ d < (|a d| * x ^ d) * m ^ d := by
    have h2 : (∑ i ∈ range d, |a i| * m ^ i) * x ^ d < (|a d| * m ^ d) * x ^ d :=
      by exact (mul_lt_mul_of_pos_right hdom hxd)
    have h3 : (|a d| * m ^ d) * x ^ d = (|a d| * x ^ d) * m ^ d := by ring
    linarith [hscale, h2, h3.le, h3.ge]
  have hSx : ∑ i ∈ range d, |a i| * x ^ i < |a d| * x ^ d :=
    lt_of_mul_lt_mul_right hlt hmd.le
  intro hzero
  rw [Finset.sum_range_succ] at hzero
  have habs : |∑ i ∈ range d, a i * x ^ i| ≤ ∑ i ∈ range d, |a i| * x ^ i := by
    refine (Finset.abs_sum_le_sum_abs _ _).trans (le_of_eq (Finset.sum_congr rfl ?_))
    intro i _
    rw [abs_mul, abs_pow, abs_of_pos hx0]
  have heq : |∑ i ∈ range d, a i * x ^ i| = |a d| * x ^ d := by
    have hneg : (∑ i ∈ range d, a i * x ^ i) = -(a d * x ^ d) := by linarith
    rw [hneg, abs_neg, abs_mul, abs_pow, abs_of_pos hx0]
  linarith

/-! ## 2. Horner evaluation, and the bridge to `Finset.range` sums

The criterion speaks of `∑ i ∈ range (d+1), a i * x ^ i` with `a : ℕ → ℚ`.  A 511-term
`Finset` sum over ℚ literals is not something a kernel can evaluate, so every COMPUTATION
below happens on `List ℕ` / `List ℤ` by Horner, where literal `Nat` arithmetic is kernel
accelerated, and these bridges carry the answer back. -/

/-- Horner evaluation of an ascending integer coefficient list. -/
def hornerZ : List ℤ → ℤ → ℤ
  | [], _ => 0
  | c :: cs, x => c + x * hornerZ cs x

/-- Horner evaluation of an ascending natural coefficient list. -/
def hornerN : List ℕ → ℕ → ℕ
  | [], _ => 0
  | c :: cs, m => c + m * hornerN cs m

/-- Horner evaluation reduced mod `p` at every step, so no intermediate value grows. -/
def hornerNM : List ℕ → ℕ → ℕ → ℕ
  | [], _, _ => 0
  | c :: cs, m, p => (c + m * hornerNM cs m p) % p

/-- `scanNZ L p k = true` exactly when `hornerNM L n p ≠ 0` for every `n < k`. -/
def scanNZ (L : List ℕ) (p : ℕ) : ℕ → Bool
  | 0 => true
  | k + 1 => (hornerNM L k p != 0) && scanNZ L p k

/-- `|z|` in ℚ is the cast of `z.natAbs`. -/
theorem cast_abs_natAbs (z : ℤ) : |((z : ℤ) : ℚ)| = ((z.natAbs : ℕ) : ℚ) := by
  rw [← Int.cast_abs, Int.abs_eq_natAbs, Int.cast_natCast]

/-- The absolute-value sum the criterion's hypothesis asks for, as a `ℕ` Horner value. -/
theorem sum_range_abs (L : List ℤ) (m : ℕ) :
    ∑ i ∈ range L.length, |((L.getD i 0 : ℤ) : ℚ)| * (m : ℚ) ^ i
      = ((hornerN (L.map Int.natAbs) m : ℕ) : ℚ) := by
  induction L with
  | nil => simp [hornerN]
  | cons c cs ih =>
      rw [List.length_cons, Finset.sum_range_succ']
      have hstep : ∀ i : ℕ, |(((c :: cs).getD (i + 1) 0 : ℤ) : ℚ)| * (m : ℚ) ^ (i + 1)
          = (|((cs.getD i 0 : ℤ) : ℚ)| * (m : ℚ) ^ i) * (m : ℚ) := by
        intro i
        simp only [List.getD_cons_succ, pow_succ]
        ring
      rw [Finset.sum_congr rfl (fun i _ => hstep i), ← Finset.sum_mul, ih]
      simp only [List.getD_cons_zero, pow_zero, mul_one, List.map_cons, hornerN,
        cast_abs_natAbs]
      push_cast
      ring

/-- The signed evaluation, as a `ℤ` Horner value. -/
theorem sum_range_hornerZ (L : List ℤ) (x : ℤ) :
    ∑ i ∈ range L.length, ((L.getD i 0 : ℤ) : ℚ) * (x : ℚ) ^ i
      = ((hornerZ L x : ℤ) : ℚ) := by
  induction L with
  | nil => simp [hornerZ]
  | cons c cs ih =>
      rw [List.length_cons, Finset.sum_range_succ']
      have hstep : ∀ i : ℕ, (((c :: cs).getD (i + 1) 0 : ℤ) : ℚ) * (x : ℚ) ^ (i + 1)
          = (((cs.getD i 0 : ℤ) : ℚ) * (x : ℚ) ^ i) * (x : ℚ) := by
        intro i
        simp only [List.getD_cons_succ, pow_succ]
        ring
      rw [Finset.sum_congr rfl (fun i _ => hstep i), ← Finset.sum_mul, ih]
      simp only [List.getD_cons_zero, pow_zero, mul_one, hornerZ]
      push_cast
      ring

/-- The reducing Horner agrees with the plain one modulo `p`. -/
theorem hornerNM_eq (L : List ℕ) (m p : ℕ) : hornerNM L m p = hornerN L m % p := by
  induction L with
  | nil => simp [hornerNM, hornerN]
  | cons c cs ih =>
      simp only [hornerNM, hornerN, ih]
      exact ((Nat.mod_modEq (hornerN cs m) p).mul_left m).add_left c

/-- Reducing the coefficients mod `p` reduces the value mod `p`. -/
theorem hornerN_map_modEq (L : List ℤ) (n p : ℕ) (hp : 0 < p) :
    ((hornerN (L.map (fun z => (z % (p : ℤ)).toNat)) n : ℕ) : ℤ)
      ≡ hornerZ L (n : ℤ) [ZMOD (p : ℤ)] := by
  induction L with
  | nil => simp [hornerN, hornerZ]
  | cons c cs ih =>
      have hp' : (0 : ℤ) < (p : ℤ) := by exact_mod_cast hp
      have hc : (((c % (p : ℤ)).toNat : ℕ) : ℤ) = c % (p : ℤ) :=
        Int.toNat_of_nonneg (Int.emod_nonneg c (ne_of_gt hp'))
      simp only [List.map_cons, hornerN, hornerZ, Nat.cast_add, Nat.cast_mul, hc]
      exact (Int.mod_modEq c (p : ℤ)).add (ih.mul_left (n : ℤ))

/--
A nonzero mod-`p` Horner value certifies that the integer value is nonzero.  This is what
turns a 1128-point scan over residues into a statement about 849-digit integers.
-/
theorem hornerZ_ne_zero_of_hornerNM (L : List ℤ) (R : List ℕ) (n p : ℕ) (hp : 0 < p)
    (hR : L.map (fun z => (z % (p : ℤ)).toNat) = R) (h : hornerNM R n p ≠ 0) :
    hornerZ L (n : ℤ) ≠ 0 := by
  subst hR
  intro h0
  apply h
  rw [hornerNM_eq]
  have key := hornerN_map_modEq L n p hp
  rw [h0] at key
  have hdvd : (p : ℤ) ∣ ((hornerN (L.map (fun z => (z % (p : ℤ)).toNat)) n : ℕ) : ℤ) :=
    Int.modEq_zero_iff_dvd.mp key
  have hd : p ∣ hornerN (L.map (fun z => (z % (p : ℤ)).toNat)) n := by exact_mod_cast hdvd
  simpa [Nat.ModEq] using Nat.modEq_zero_iff_dvd.mpr hd

/-- `scanNZ` says what it is meant to say. -/
theorem scanNZ_spec {L : List ℕ} {p : ℕ} : ∀ {k : ℕ}, scanNZ L p k = true →
    ∀ n, n < k → hornerNM L n p ≠ 0 := by
  intro k
  induction k with
  | zero => intro _ n hn; exact absurd hn (Nat.not_lt_zero n)
  | succ k ih =>
      intro h n hn
      rw [scanNZ, Bool.and_eq_true, bne_iff_ne] at h
      rcases Nat.lt_or_ge n k with h1 | h1
      · exact ih h.2 n h1
      · have hnk : n = k := by omega
        exact hnk ▸ h.1

