/-- The dominance hypothesis in the exact shape `no_root_from_dominance` consumes. -/
theorem c0_dominance :
    ∑ i ∈ range 510, |a0 i| * (1120 : ℚ) ^ i
      < |a0 510| * (1120 : ℚ) ^ 510 := by
  have hs : ∑ i ∈ range 510, |a0 i| * (1120 : ℚ) ^ i
      = ((hornerN (c0low.map Int.natAbs) 1120 : ℕ) : ℚ) := by
    rw [← sum_range_abs c0low 1120, c0low_length]
    refine Finset.sum_congr rfl (fun i hi => ?_)
    rw [a0_low (Finset.mem_range.mp hi)]
    norm_num
