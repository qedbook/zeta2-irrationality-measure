/-- **`S2c` CLOSED below `p²`**: at a polar row on the stratum with `m < p²`, the coefficient
bound holds — every LO and TAIL block of `h_m` is `0 mod p²`. -/
theorem S2c_closed {n p r : ℕ} (hp : p ∈ Zeta2PhiT.phiWindow n) (hr : r < 16 * n)
    (hpol : p ∣ r + 1) (hm : 11 * n + 1 + r < p ^ 2) (h1 : 6 * p ≤ 13 * (n % p))
    (h2 : 15 * (n % p) < 7 * p) :
    Zeta2PtpPolar.PVal p (Zeta2PhiT.phiT (Int.fract ((n : ℚ) / (p : ℚ))) + Zeta2PtpPoly.bbit n p r - 1)
      ((Zeta2PtpPoly.coeff n r : ℤ) : ℚ) := by
  have hpp := Zeta2PhiT.prime_of_mem_phiWindow hp
  have : Fact p.Prime := ⟨hpp⟩
  have hp0 := hpp.pos
  have hsq := Zeta2PhiT.sq_gt_of_mem_phiWindow hp
  have hn1 := Zeta2PtpPolar.pos_of_mem_phiWindow hp
  have hp2 : 2 < p := by
    by_contra hc
    have : p ^ 2 ≤ 4 := by
      have : p ≤ 2 := by omega
      calc p ^ 2 ≤ 2 ^ 2 := Nat.pow_le_pow_left this 2
        _ = 4 := by norm_num
    omega
  refine Zeta2PtpResPair.pval_coeff_of_dvd hp ?_
  rw [Zeta2PtpKumRes.padicValNat_LC_polar hp hm hpol, Zeta2PtpKumRes.bbit_polar hpol,
    Zeta2PtpS2c.phiT_piece13_res hp0 (by omega) (by omega)]
  have hmp : (11 * n + 1 + r) % p = (11 * n) % p := by
    rw [show 11 * n + 1 + r = 11 * n + (r + 1) by ring, Nat.add_mod, Nat.mod_eq_zero_of_dvd hpol,
      Nat.add_zero, Nat.mod_mod]
  have hM1 : (11 * n + 1 + r) / p < p := by
    rw [Nat.div_lt_iff_lt_mul hp0, ← sq]; exact hm
  have hn' : n = p * (n / p) + n % p := (Nat.div_add_mod n p).symm
  have hwin : 26 * (p * (n / p) + n % p) + 1 < p ^ 2 := by rw [← hn']; exact hsq
  generalize n / p = a at hn' hwin
  generalize n % p = s at hn' h1 h2 hwin
  have hpa := win_bound hwin h1 (by norm_num)
  obtain ⟨hone_lo, htwo_lo⟩ := S2c_lo hn' h1 h2 hmp
  obtain ⟨hone_hi, htwo_hi⟩ := S2c_hi hn' h1 h2 hmp
  have hdeg := S2c_deg hn' h1 h2 hmp
  obtain ⟨r5, -, -, -, -, -, -⟩ := S2c_res hn' h1 h2
  have hdvd : (p : ℤ) ^ 2 ∣ Zeta2NewtonAssemble.hc n (11 * n + 1 + r) := by
    refine pow_dvd_hc_of_blocks hp0 hn1 (fun t ht => ?_) (fun t ht => ?_)
    · by_cases hz : 13 * a + 6 < t
      · have e1 : (13 * a + 6 + 1) * p ≤ t * p := Nat.mul_le_mul_right p hz
        have e2 : (13 * a + 6 + 1) * p = 13 * (p * a) + 7 * p := by ring
        exact lo_all_zero hn1 (by omega)
      by_cases hpast : (11 * n + 1 + r) / p ≤ t
      · exact lo4_block_past hn1 htwo_lo hpast
      exact lo4_block_dvd hp2 hn1 hdeg hone_lo htwo_lo
        (fun u hu hk ho1 ho2 ho3 => S2c_lo_hsup hn' h1 h2 hpa hmp (by omega) hu hk ho1 ho2 ho3)
        (by omega) hM1
    · by_cases hz : t < 26 * a + 12
      · have e1 : t * p + p ≤ (26 * a + 12) * p := by
          have := Nat.mul_le_mul_right p hz
          rw [Nat.succ_mul] at this; exact this
        have e2 : (26 * a + 12) * p = 26 * (p * a) + 12 * p := by ring
        exact hi_all_zero hn1 (by omega)
      by_cases hpast : (11 * n + 1 + r) / p ≤ t
      · exact hi4_block_past hn1 htwo_hi hpast
      exact hi4_block_dvd hp2 hn1 hdeg hone_hi htwo_hi
        (fun u hu hk ho1 ho2 ho3 => S2c_hi_hsup hn' h1 h2 hmp (by omega) (by omega) hu hk ho1 ho2 ho3)
        (by omega) hM1
  rw [show 2 + 1 - 1 + 1 = 1 + 2 by rfl, pow_add, pow_one]
  exact mul_dvd_mul_left _ hdvd

