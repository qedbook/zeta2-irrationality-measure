theorem az3_scan : scanNZ rz3 scanP 365 = true := by
  decide +kernel

/-- The scan, as nonvanishing at every index it covers. -/
theorem az3_ne_zero_of_lt (n : ℕ) (hn : n < 365) : hornerZ az3 (n : ℤ) ≠ 0 :=
  hornerZ_ne_zero_of_hornerNM az3 rz3 n scanP (by decide) az3_reduction
    (scanNZ_spec az3_scan n hn)

/-- **The cleared `Ã₃` is nonzero at EVERY natural `n`** -- the scan below 365, the
criterion at and above 364, and the two ranges overlap. -/
theorem az3_ne_zero (n : ℕ) : hornerZ az3 (n : ℤ) ≠ 0 := by
  rcases Nat.lt_or_ge n 365 with h | h
  · exact az3_ne_zero_of_lt n h
  · exact az3_ne_zero_of_ge n (by omega)

/-! ## 5. Back to the base module's own `al3` -/

/-- The clearing denominator is nonzero -- the base module's own `xdne<k>` for its `xdₖ`. -/
theorem ad3_ne : (ad3 : ℚ) ≠ 0 := by decide +kernel

/--
**The tie: the base module's literal `List ℚ` IS this file's integer list over one
denominator.**  `al3` is emitted as 155 ℚ literals and nothing in Lean relates it to `az3`
until this theorem does; the two are byte-different encodings of the same rationals, and
§6a's lesson in this corpus is that an unstated identification is exactly where a receipt
about the wrong object comes from.  One `decide +kernel`, the same ring the base's own
kernel shards decide `al3` in (`kha<j>_<n>`).
-/
theorem al3_clear : StarForallCandt2.al3 = az3.map (fun c : ℤ => (c : ℚ) / (ad3 : ℚ)) := by
  decide +kernel

/--
Horner over a ℚ coefficient list obtained by dividing ONE integer list by ONE denominator.
Stated for an arbitrary `L` and `d` because the sibling rows (`λden`, `L_t1`) need the same
step, and proved through the base module's own `polB_eval` so no `Polynomial` internals are
touched here.
-/
theorem polB_map_div_eval (L : List ℤ) (d : ℚ) (n : ℕ) :
    (StarForallCandt2.polB (L.map (fun c : ℤ => (c : ℚ) / d))).eval (n : ℚ)
      = ((hornerZ L (n : ℤ) : ℤ) : ℚ) / d := by
  rw [StarForallCandt2.polB_eval]
  induction L with
  | nil => simp [hornerZ]
  | cons c cs ih =>
      simp only [List.map_cons, List.foldr_cons, hornerZ]
      rw [ih]
      push_cast
      ring

/--
**ROW PAIR-N.**  `Ã₃(n) ≠ 0` for every natural `n`, on the base module's own `al3` — the
`j = 3` entry of the operator `Zeta2Pair6.betaHat` is built from, and therefore the division
