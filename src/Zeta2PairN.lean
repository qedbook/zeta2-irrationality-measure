/-! ## 4. PAIR-N at the hat solve's `Ã₃` -/

/-- `az3low` really does hold the 154 low-order coefficients. -/
theorem az3low_length : az3low.length = 154 := by rfl

/-- `az3` is the whole degree-154 cleared polynomial. -/
theorem az3_length : az3.length = 155 := by
  simp [az3, az3low_length]

/-- Below the leading index, `aq3` reads off `az3low`. -/
theorem aq3_low {i : ℕ} (h : i < 154) : aq3 i = ((az3low.getD i 0 : ℤ) : ℚ) := by
  rw [aq3, az3, List.getD_eq_getElem?_getD, List.getD_eq_getElem?_getD,
    List.getElem?_append_left (by rw [az3low_length]; exact h)]

/-- At the leading index, `aq3` reads off `az3lead`. -/
theorem aq3_lead : aq3 154 = (az3lead : ℚ) := by
  rw [aq3, az3, List.getD_eq_getElem?_getD,
    List.getElem?_append_right (by rw [az3low_length]), az3low_length]
  simp

/--
**The dominance inequality for the cleared `Ã₃`, in exact `ℕ` arithmetic at `m₀ = 364`.**
One exact check kills the whole real tail: each term of `|a_i| m^i / (|a_d| m^d)` is strictly
decreasing in real `m > 0`, so the criterion of section 1 lifts it.  The kernel evaluates a
154-term Horner sum against a 194-digit leading coefficient times `364 ^ 154`.
-/
theorem az3_dominance_nat :
    hornerN (az3low.map Int.natAbs) 364 < az3lead.natAbs * 364 ^ 154 := by
  decide +kernel

/--
**K-M0, in Lean.**  The same inequality FAILS at `m₀ - 1`, so `364` is the LEAST integer the
criterion admits for this polynomial.  Without it the emitted `m₀` would be unfalsifiable: any
larger number also works, and a scan that is longer than it needs to be reads exactly the same.
-/
theorem az3_dominance_minimal :
    ¬ (hornerN (az3low.map Int.natAbs) 363 < az3lead.natAbs * 363 ^ 154) := by
  decide +kernel

/-- The dominance hypothesis in the exact shape `no_root_from_dominance` consumes. -/
theorem az3_dominance :
    ∑ i ∈ range 154, |aq3 i| * (364 : ℚ) ^ i
      < |aq3 154| * (364 : ℚ) ^ 154 := by
  have hs : ∑ i ∈ range 154, |aq3 i| * (364 : ℚ) ^ i
      = ((hornerN (az3low.map Int.natAbs) 364 : ℕ) : ℚ) := by
    rw [← sum_range_abs az3low 364, az3low_length]
    refine Finset.sum_congr rfl (fun i hi => ?_)
    rw [aq3_low (Finset.mem_range.mp hi)]
    norm_num
  have hl : |aq3 154| * (364 : ℚ) ^ 154
      = ((az3lead.natAbs * 364 ^ 154 : ℕ) : ℚ) := by
    rw [aq3_lead, cast_abs_natAbs]
    push_cast
    ring
  rw [hs, hl]
  exact_mod_cast az3_dominance_nat

/-- No RATIONAL `x ≥ 364` is a root of the cleared `Ã₃` -- the criterion of section 1,
instantiated on the hat solve's own coefficients. -/
theorem az3_no_rat_root (x : ℚ) (hx : (364 : ℚ) ≤ x) :
    ∑ i ∈ range (154 + 1), aq3 i * x ^ i ≠ 0 :=
  no_root_from_dominance aq3 364 (by norm_num) az3_dominance x hx

/-- The same, as a statement about the integer index the recurrence runs on. -/
theorem az3_ne_zero_of_ge (n : ℕ) (hn : 364 ≤ n) : hornerZ az3 (n : ℤ) ≠ 0 := by
  intro h0
  refine az3_no_rat_root (n : ℚ) (by exact_mod_cast hn) ?_
  have hsum : ∑ i ∈ range (154 + 1), aq3 i * (n : ℚ) ^ i
      = ((hornerZ az3 (n : ℤ) : ℤ) : ℚ) := by
    rw [← sum_range_hornerZ az3 (n : ℤ), az3_length]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [aq3]
    push_cast
    ring
  rw [hsum, h0]
  norm_num

/-- `rz3` is the cleared `Ã₃` reduced mod `scanP`. -/
theorem az3_reduction : az3.map (fun z => (z % (scanP : ℤ)).toNat) = rz3 := by
  decide +kernel

/--
