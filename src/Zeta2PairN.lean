dominance criterion every rational `x ≥ 364`.
-/
theorem L_ne_zero (n : ℕ) : (StarForallCandt2.polB StarForallCandt2.al3).eval (n : ℚ) ≠ 0 := by
  rw [al3_clear, polB_map_div_eval az3 (ad3 : ℚ) n]
  refine div_ne_zero ?_ ad3_ne
  exact_mod_cast az3_ne_zero n

